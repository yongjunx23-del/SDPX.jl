#!/bin/bash
#PBS -N sdpx_legacy_provider_regression
#PBS -q sugon
#PBS -l nodes=1:ppn=5
#PBS -l mem=24gb
#PBS -l walltime=04:00:00
#PBS -j oe

# v041-legacy-provider focused regression runner.  PBS ppn=5; Julia threads 4;
# solver threads 4; BLAS/OMP/MKL/BLIS threads 1.  It runs the LA backend
# regressions, executed diagnostics, the bundled-provider architecture gate,
# and the small dense BigFloat standard-vs-legacy identity smoke.  The gate
# requires the bundled SDPXLegacyLA provider to be included and selected, so
# this runner fails closed if the provider contract regresses.
set -euo pipefail

: "${NODE_NAME:?set NODE_NAME to the pinned compute node}"
: "${CANDIDATE_SOURCE:?set CANDIDATE_SOURCE to the immutable candidate source}"
: "${CANDIDATE_SOURCE_SHA256:?set CANDIDATE_SOURCE_SHA256 to the expected source-tree SHA-256}"
: "${CANDIDATE_ENV:?set CANDIDATE_ENV to the pre-instantiated Julia environment}"
: "${SDPX_SITE_ENV:?set SDPX_SITE_ENV to the site environment script}"
: "${SDPX_DEPOT_PATH:?set SDPX_DEPOT_PATH to the offline Julia depot}"
: "${CAMPAIGN_ID:?set CAMPAIGN_ID to the shared campaign identifier}"
: "${OUTPUT_ROOT:?set OUTPUT_ROOT to a fresh result directory}"

ACTUAL_NODE="$(hostname)"
if [ "$ACTUAL_NODE" != "$NODE_NAME" ]; then
  echo "NODE_NAME guard failed: actual=$ACTUAL_NODE expected=$NODE_NAME" >&2
  exit 1
fi
if [ -e "$OUTPUT_ROOT" ]; then
  echo "OUTPUT_ROOT already exists; refusing to mutate an existing result path: $OUTPUT_ROOT" >&2
  exit 1
fi
mkdir -p "$OUTPUT_ROOT"

write_failed() {
  printf 'status = "FAILED"\n' > "$OUTPUT_ROOT/FAILED" 2>/dev/null || true
}
trap write_failed EXIT

source "$SDPX_SITE_ENV"
: "${JULIA_BIN:?set JULIA_BIN directly or through SDPX_SITE_ENV}"
test -d "$CANDIDATE_SOURCE"
test -f "$CANDIDATE_SOURCE/src/SDPX.jl"
test -f "$CANDIDATE_ENV/Project.toml"

export JULIA_PKG_OFFLINE=true
export JULIA_DEPOT_PATH="$SDPX_DEPOT_PATH"
export JULIA_NUM_THREADS=4
export SDPX_SOLVER_THREADS=4
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export BLIS_NUM_THREADS=1
export SDPX_CANDIDATE="$CANDIDATE_SOURCE"
export SDPX_LEGACY_PROVIDER_SYMBOL="${SDPX_LEGACY_PROVIDER_SYMBOL:-sdpx_legacy_la}"
export SDPX_LEGACY_PROVIDER_CALL_MARKER="${SDPX_LEGACY_PROVIDER_CALL_MARKER:-_sdpx_legacy_la_call}"
export SDPX_LEGACY_OWNERSHIP="${SDPX_LEGACY_OWNERSHIP:-owned_mutable_scalars}"

[ "$JULIA_NUM_THREADS" = "4" ] || {
  echo "JULIA_NUM_THREADS contract failed: $JULIA_NUM_THREADS" >&2
  exit 1
}
[ "$SDPX_SOLVER_THREADS" = "4" ] || {
  echo "SDPX_SOLVER_THREADS contract failed: $SDPX_SOLVER_THREADS" >&2
  exit 1
}
[ "${PBS_NP:-unset}" = "5" ] || {
  echo "PBS_NP contract failed: ${PBS_NP:-unset}" >&2
  exit 1
}
for var in OPENBLAS_NUM_THREADS OMP_NUM_THREADS MKL_NUM_THREADS BLIS_NUM_THREADS; do
  value="${!var}"
  [ "$value" = "1" ] || {
    echo "$var contract failed: $value" >&2
    exit 1
  }
done

CANDIDATE_HASH_ACTUAL="$(
  cd "$CANDIDATE_SOURCE"
  export LC_ALL=C
  find . -type f -not -path './.git' -not -path './.git/*' -print0 \
    | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}'
)"
if [ "$CANDIDATE_HASH_ACTUAL" != "$CANDIDATE_SOURCE_SHA256" ]; then
  echo "candidate source SHA-256 mismatch: actual=$CANDIDATE_HASH_ACTUAL expected=$CANDIDATE_SOURCE_SHA256" >&2
  exit 1
fi

{
  echo "campaign_id=$CAMPAIGN_ID"
  echo "pbs_job_id=${PBS_JOBID:-unknown}"
  echo "hostname=$ACTUAL_NODE"
  echo "expected_node=$NODE_NAME"
  echo "started=$(date -Iseconds)"
  echo "candidate_source=$CANDIDATE_SOURCE"
  echo "candidate_source_realpath=$(realpath "$CANDIDATE_SOURCE")"
  echo "candidate_env=$CANDIDATE_ENV"
  echo "julia_bin=$JULIA_BIN"
  echo "julia_version=$("$JULIA_BIN" --version 2>/dev/null | head -n 1)"
  echo "candidate_source_sha256=$CANDIDATE_HASH_ACTUAL"
  echo "candidate_source_sha256_expected=$CANDIDATE_SOURCE_SHA256"
  echo "julia_threads=$JULIA_NUM_THREADS"
  echo "solver_threads=$SDPX_SOLVER_THREADS"
  echo "blas_threads=$OPENBLAS_NUM_THREADS"
  echo "pbs_ppn=${PBS_NP:-5}"
  echo "legacy_provider_symbol_expected=$SDPX_LEGACY_PROVIDER_SYMBOL"
  echo "legacy_provider_call_marker_expected=$SDPX_LEGACY_PROVIDER_CALL_MARKER"
  echo "legacy_ownership_expected=$SDPX_LEGACY_OWNERSHIP"
  lscpu | grep -E 'Model name|Socket|NUMA|CPU\(s\)' || true
} > "$OUTPUT_ROOT/environment.txt"

"$JULIA_BIN" \
  --project="$CANDIDATE_ENV" \
  --startup-file=no \
  -t 4 \
  -e '
    using SDPX, Test, LinearAlgebra, Random, SparseArrays, MultiFloats
    expected_root = realpath(ENV["SDPX_CANDIDATE"])
    expected_src = realpath(joinpath(expected_root, "src", "SDPX.jl"))
    actual_src = realpath(pathof(SDPX))
    actual_root = realpath(joinpath(dirname(actual_src), ".."))
    println("CANDIDATE_PATHOF ", actual_src)
    println("CANDIDATE_ROOT ", actual_root)
    println("JULIA_NTHREADS ", Threads.nthreads())
    println("BLAS_THREADS ", LinearAlgebra.BLAS.get_num_threads())
    if actual_src != expected_src || actual_root != expected_root
      error("loaded SDPX from $(actual_src) (root $(actual_root)); expected $(expected_src) (root $(expected_root))")
    end
    Threads.nthreads() == 4 || error("Julia thread mismatch: $(Threads.nthreads())")
    LinearAlgebra.BLAS.get_num_threads() == 1 || error(
      "BLAS thread mismatch: $(LinearAlgebra.BLAS.get_num_threads())",
    )
    for var in ("OPENBLAS_NUM_THREADS", "OMP_NUM_THREADS", "MKL_NUM_THREADS", "BLIS_NUM_THREADS")
      get(ENV, var, "") == "1" || error("$var must be 1, got $(repr(get(ENV, var, "")))")
    end
    println("RUNTIME_CONTRACT julia=4 plan=4 blas=1")
    include(joinpath(expected_root, "test", "la_backend_regressions.jl"))
    include(joinpath(expected_root, "test", "executed_diagnostics.jl"))
  ' > "$OUTPUT_ROOT/regressions.log" 2>&1

if ! grep -qF 'RUNTIME_CONTRACT julia=4 plan=4 blas=1' "$OUTPUT_ROOT/regressions.log"; then
  echo "runtime contract marker missing from regressions log" >&2
  exit 1
fi
if grep -qE 'Test Summary:.*(Fail|Error)|Test Failed|ERROR:' "$OUTPUT_ROOT/regressions.log"; then
  echo "regression test failures detected" >&2
  exit 1
fi

"$JULIA_BIN" \
  --project="$CANDIDATE_ENV" \
  --startup-file=no \
  -t 4 \
  "$CANDIDATE_SOURCE/cluster-probes/v041-legacy-provider/legacy_provider_gate.jl" \
  > "$OUTPUT_ROOT/gate.log" 2>&1
grep -qF 'PROVIDER_GATE=OK' "$OUTPUT_ROOT/gate.log" || {
  echo "legacy provider gate did not pass" >&2
  exit 1
}
grep -qF 'RUNTIME_CONTRACT julia=4 plan=4 blas=1' "$OUTPUT_ROOT/gate.log" || {
  echo "gate runtime contract marker missing" >&2
  exit 1
}

/usr/bin/time -v -o "$OUTPUT_ROOT/process.time.txt" \
  "$JULIA_BIN" \
  --project="$CANDIDATE_ENV" \
  --startup-file=no \
  -t 4 \
  "$CANDIDATE_SOURCE/cluster-probes/v041-legacy-provider/bigfloat_identity_smoke.jl" \
  > "$OUTPUT_ROOT/smoke.log" 2>&1
grep -qF 'LEGACY_PROVIDER_AB full_solve_standard=ok' "$OUTPUT_ROOT/smoke.log" || {
  echo "standard full solve marker missing" >&2
  exit 1
}
grep -qF 'LEGACY_PROVIDER_AB full_solve_legacy=ok' "$OUTPUT_ROOT/smoke.log" || {
  echo "legacy full solve marker missing" >&2
  exit 1
}
grep -qF 'LEGACY_PROVIDER_AB identity=ok' "$OUTPUT_ROOT/smoke.log" || {
  echo "identity smoke marker missing" >&2
  exit 1
}
grep -qF 'RUNTIME_CONTRACT julia=4 plan=4 blas=1' "$OUTPUT_ROOT/smoke.log" || {
  echo "smoke runtime contract marker missing" >&2
  exit 1
}

append_time_summary() {
  local rss user sys wall cpu
  rss="$(awk '/Maximum resident set size/ {print $6}' "$OUTPUT_ROOT/process.time.txt")"
  user="$(awk '/User time/ {print $4}' "$OUTPUT_ROOT/process.time.txt")"
  sys="$(awk '/System time/ {print $4}' "$OUTPUT_ROOT/process.time.txt")"
  wall="$(awk -F': ' '/Elapsed \(wall clock\) time/ {print $2}' "$OUTPUT_ROOT/process.time.txt" | awk -F: '{ if (NF == 3) { h=$1; m=$2; s=$3 } else { h=0; m=$1; s=$2 }; gsub(/[^0-9.]/, "", s); printf "%.3f", h*3600 + m*60 + s }')"
  # Keep the branch explicit: some cluster awk implementations parse the
  # ternary expression as a redirection when it appears next to `printf`.
  cpu="$(awk -v u="$user" -v s="$sys" -v w="$wall" 'BEGIN { if (w > 0) { printf "%.3f", (u+s)/w } else { printf "0.000" } }')"
  {
    echo "rss_kib=${rss:-unavailable}"
    echo "user_cpu_seconds=${user:-unavailable}"
    echo "system_cpu_seconds=${sys:-unavailable}"
    echo "wall_seconds=${wall:-unavailable}"
    echo "cpu_utilization=${cpu:-unavailable}"
  } >> "$OUTPUT_ROOT/environment.txt"
}
append_time_summary

{
  echo "runtime_contract=ok"
  echo "provider_gate=ok"
  echo "finished=$(date -Iseconds)"
  echo "status=PASSED"
} >> "$OUTPUT_ROOT/environment.txt"
date -Iseconds > "$OUTPUT_ROOT/SUCCESS"
trap - EXIT
