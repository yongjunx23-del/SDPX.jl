#!/bin/bash
#PBS -N sdpx_unified_la_bigfloat_generic
#PBS -q sugon
#PBS -l nodes=1:ppn=1
#PBS -l mem=24gb
#PBS -l walltime=04:00:00
#PBS -j oe

# v041-unified-la BigFloat generic-vs-legacy probe.  One Julia/solver
# thread, one BLAS/OpenMP/MKL/BLIS thread, 256-bit working precision and
# 512-bit references.  Warmup 1, timed 3.
set -euo pipefail

: "${NODE_NAME:?set NODE_NAME to the pinned compute node}"
: "${CANDIDATE_SOURCE:?set CANDIDATE_SOURCE to the immutable candidate source}"
: "${CANDIDATE_SOURCE_SHA256:?set CANDIDATE_SOURCE_SHA256 to the expected source-tree SHA-256}"
: "${CANDIDATE_ENV:?set CANDIDATE_ENV to the pre-instantiated Julia environment}"
: "${SDPX_SITE_ENV:?set SDPX_SITE_ENV to the site environment script}"
: "${SDPX_DEPOT_PATH:?set SDPX_DEPOT_PATH to the offline Julia depot}"
: "${CAMPAIGN_ID:?set CAMPAIGN_ID to the shared campaign identifier}"
: "${OUTPUT_ROOT:?set OUTPUT_ROOT to a fresh result directory}"

ACTUAL_NODE="$(hostname)"
if [ "$ACTUAL_NODE" != "$NODE_NAME" ]; then
  echo "NODE_NAME guard failed: actual=$ACTUAL_NODE expected=$NODE_NAME" >&2
  exit 1
fi
if [ -e "$OUTPUT_ROOT" ]; then
  echo "OUTPUT_ROOT already exists; refusing to mutate an existing result path: $OUTPUT_ROOT" >&2
  exit 1
fi
mkdir -p "$OUTPUT_ROOT"

write_failed() {
  printf 'status = "FAILED"\n' > "$OUTPUT_ROOT/FAILED" 2>/dev/null || true
}
trap write_failed EXIT

source "$SDPX_SITE_ENV"
: "${JULIA_BIN:?set JULIA_BIN directly or through SDPX_SITE_ENV}"
test -d "$CANDIDATE_SOURCE"
test -f "$CANDIDATE_SOURCE/src/SDPX.jl"
test -f "$CANDIDATE_ENV/Project.toml"

export JULIA_PKG_OFFLINE=true
export JULIA_DEPOT_PATH="$SDPX_DEPOT_PATH"
export JULIA_NUM_THREADS=1
export SDPX_SOLVER_THREADS=1
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export BLIS_NUM_THREADS=1
export SDPX_CANDIDATE="$CANDIDATE_SOURCE"

[ "$JULIA_NUM_THREADS" = "1" ] || {
  echo "JULIA_NUM_THREADS contract failed: $JULIA_NUM_THREADS" >&2
  exit 1
}
[ "$SDPX_SOLVER_THREADS" = "1" ] || {
  echo "SDPX_SOLVER_THREADS contract failed: $SDPX_SOLVER_THREADS" >&2
  exit 1
}
[ "${PBS_NP:-unset}" = "1" ] || {
  echo "PBS_NP contract failed: ${PBS_NP:-unset}" >&2
  exit 1
}
for var in OPENBLAS_NUM_THREADS OMP_NUM_THREADS MKL_NUM_THREADS BLIS_NUM_THREADS; do
  [ "${!var}" = "1" ] || {
    echo "$var contract failed: ${!var}" >&2
    exit 1
  }
done

CANDIDATE_HASH_ACTUAL="$(
  cd "$CANDIDATE_SOURCE"
  export LC_ALL=C
  find . -type f -not -path './.git' -not -path './.git/*' -print0 \
    | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}'
)"
[ "$CANDIDATE_HASH_ACTUAL" = "$CANDIDATE_SOURCE_SHA256" ] || {
  echo "candidate source SHA-256 mismatch" >&2
  exit 1
}

{
  echo "campaign_id=$CAMPAIGN_ID"
  echo "pbs_job_id=${PBS_JOBID:-unknown}"
  echo "hostname=$ACTUAL_NODE"
  echo "expected_node=$NODE_NAME"
  echo "started=$(date -Iseconds)"
  echo "candidate_source=$CANDIDATE_SOURCE"
  echo "candidate_source_realpath=$(realpath "$CANDIDATE_SOURCE")"
  echo "julia_bin=$JULIA_BIN"
  echo "julia_version=$("$JULIA_BIN" --version 2>/dev/null | head -n 1)"
  echo "candidate_source_sha256=$CANDIDATE_HASH_ACTUAL"
  echo "julia_threads=$JULIA_NUM_THREADS"
  echo "solver_threads=$SDPX_SOLVER_THREADS"
  echo "blas_threads=$OPENBLAS_NUM_THREADS"
  echo "pbs_ppn=${PBS_NP:-1}"
  lscpu | grep -E 'Model name|Socket|NUMA|CPU\(s\)' || true
} > "$OUTPUT_ROOT/environment.txt"

/usr/bin/time -v -o "$OUTPUT_ROOT/process.time.txt" \
  "$JULIA_BIN" \
  --project="$CANDIDATE_ENV" \
  --startup-file=no \
  -t 1 \
  "$CANDIDATE_SOURCE/cluster-probes/v041-unified-la/bigfloat_generic_probe.jl" \
  > "$OUTPUT_ROOT/bigfloat_generic.log" 2>&1

grep -qF 'BIGFLOAT_AB ' "$OUTPUT_ROOT/bigfloat_generic.log" || {
  echo "BigFloat probe produced no BIGFLOAT_AB rows" >&2
  exit 1
}
grep -qF 'CANDIDATE_PATHOF ' "$OUTPUT_ROOT/bigfloat_generic.log" || {
  echo "BigFloat probe did not assert pathof(SDPX)" >&2
  exit 1
}
grep -qF 'RUNTIME_CONTRACT julia=1 plan=1 blas=1' "$OUTPUT_ROOT/bigfloat_generic.log" || {
  echo "BigFloat probe runtime contract marker missing" >&2
  exit 1
}
grep -qF 'BIGFLOAT_AB full_solve=ok' "$OUTPUT_ROOT/bigfloat_generic.log" || {
  echo "BigFloat probe full-solve verification did not pass" >&2
  exit 1
}

append_time_summary() {
  local rss user sys wall cpu
  rss="$(awk '/Maximum resident set size/ {print $6}' "$OUTPUT_ROOT/process.time.txt")"
  user="$(awk '/User time/ {print $4}' "$OUTPUT_ROOT/process.time.txt")"
  sys="$(awk '/System time/ {print $4}' "$OUTPUT_ROOT/process.time.txt")"
  wall="$(awk -F': ' '/Elapsed \(wall clock\) time/ {print $2}' "$OUTPUT_ROOT/process.time.txt" | awk -F: '{ if (NF == 3) { h=$1; m=$2; s=$3 } else { h=0; m=$1; s=$2 }; gsub(/[^0-9.]/, "", s); printf "%.3f", h*3600 + m*60 + s }')"
  cpu="$(awk -v u="$user" -v s="$sys" -v w="$wall" 'BEGIN { printf "%.3f", w > 0 ? (u+s)/w : 0 }')"
  {
    echo "rss_kib=${rss:-unavailable}"
    echo "user_cpu_seconds=${user:-unavailable}"
    echo "system_cpu_seconds=${sys:-unavailable}"
    echo "wall_seconds=${wall:-unavailable}"
    echo "cpu_utilization=${cpu:-unavailable}"
  } >> "$OUTPUT_ROOT/environment.txt"
}
append_time_summary

{
  echo "runtime_contract=ok"
  echo "finished=$(date -Iseconds)"
  echo "status=PASSED"
} >> "$OUTPUT_ROOT/environment.txt"
date -Iseconds > "$OUTPUT_ROOT/SUCCESS"
trap - EXIT
