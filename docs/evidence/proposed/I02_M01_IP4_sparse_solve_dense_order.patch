+# The dense-order alias. Every dense MFLA cache is `solve!(destination, cache,
+# source)` (`src/factor_caches.jl:395`, `:412`, ...); QDLDL's own entry point is
+# `solve!(cache, destination, rhs)`, so a uniform adapter cannot use one call
+# shape for both. This delegates rather than reimplementing, so there is exactly
+# one solve path and the authority checks in `_solve!` are not duplicated.
+#
+# ADDITIVE: the dense-order method for `MFSparseLDLCache` does not exist
+# anywhere before this line (`grep -rn 'solve!(destination' src/ ext/` finds the
+# dense caches and nothing for the sparse one), so this adds a method and
+# overwrites nothing.
+MFLA.solve!(destination::AbstractVecOrMat{MF}, cache::MFSparseLDLCache{MF},
+            rhs::AbstractVecOrMat{MF}) where {MF<:MultiFloat} =
+    _solve!(cache, destination, rhs)
