#!/bin/bash
#PBS -N sdpx-full-eft
#PBS -q sugon
#PBS -l nodes=1:ppn=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

: "${SDPX_ROOT:?set SDPX_ROOT to the immutable SDPX source checkout}"
: "${SDPX_EFT_CACHE:?set SDPX_EFT_CACHE to the benchmark cache root}"
: "${JULIA_BIN:?set JULIA_BIN to the Julia executable}"

ARITHMETIC="${SDPX_BENCH_ARITHMETIC:-float64x4}"
case "$ARITHMETIC" in
  float64x2|float64x4) ;;
  *) echo "unsupported arithmetic: $ARITHMETIC" >&2; exit 2 ;;
esac

export JULIA_NUM_THREADS="${SDPX_JULIA_THREADS:-1}"
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_NUM_THREADS=1

RESULT_ROOT="${SDPX_RESULT_ROOT:-$PBS_O_WORKDIR/results}"
JOB_RESULT="$RESULT_ROOT/${PBS_JOBID}/${ARITHMETIC}"
mkdir -p "$JOB_RESULT"

cd "$SDPX_ROOT"
git status --porcelain | grep -q . && {
  echo "refusing to benchmark a dirty SDPX checkout" >&2
  exit 3
}

git rev-parse HEAD > "$JOB_RESULT/sdpx-commit.txt"
"$JULIA_BIN" --version > "$JOB_RESULT/julia-version.txt"
hostname > "$JOB_RESULT/hostname.txt"

"$JULIA_BIN" --startup-file=no --project=. benchmark/runner.jl large \
  --problem=csdr/full_unitarity_eft_j40_na15_nmu200_nx2_nalpha2 \
  --arithmetic="$ARITHMETIC" \
  --provider=multifloat \
  --cache-dir="$SDPX_EFT_CACHE" \
  --output="$JOB_RESULT/rows.toml" \
  --verbose
