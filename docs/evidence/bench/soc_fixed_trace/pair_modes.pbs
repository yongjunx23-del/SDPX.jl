#!/usr/bin/env bash
#PBS -N sdpx_fixed_pair
#PBS -l nodes=1:ppn=32
#PBS -l mem=128gb
#PBS -l walltime=24:00:00
#PBS -j oe

# Two isolated Julia subprocesses, one mode at a time.  Submit again with
# SDPX_PAIR_ORDER=socp-sdp to alternate order on the next allocation.
set -euo pipefail
: "${SDPX_SOURCE:?set SDPX_SOURCE to the isolated candidate source}"
HERE="$SDPX_SOURCE/docs/evidence/bench/soc_fixed_trace"
export SDPX_CASE="${SDPX_CASE:-J40}"
export SDPX_ARITHMETIC="${SDPX_ARITHMETIC:-Float64x4}"
export SDPX_THREADS="${SDPX_THREADS:-32}"
exec "$HERE/run_pair.sh"
