#!/bin/bash
#PBS -N sdpx_q3_ref
#PBS -l nodes=1:ppn=32
#PBS -l mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

[[ -n "${PBS_JOBID:-}" || "${ALLOW_INTERACTIVE:-0}" == 1 ]] || {
    echo "submit the Float64 Q3 reference through PBS" >&2
    exit 2
}
: "${SDPX_SOURCE:?set the isolated SDPX candidate source}"
: "${CSDR_MODEL:?set the immutable J40 model}"
: "${SDPX_EXPECTED_HASH:?set the J40 model SHA-256}"
: "${SDPX_REFERENCE_SOLVER:?set clarabel or mosek}"
: "${SDPX_OUTPUT_ROOT:?set an isolated result directory}"
: "${SDPX_SHARED_ENV:?set an instantiated reference-solver environment}"
: "${SDPX_SHARED_DEPOT:?set the read-only shared Julia depot}"
: "${CSDR_RELEASE:?set the immutable CSDR release}"

[[ "${SDPX_REFERENCE_SOLVER}" == clarabel || "${SDPX_REFERENCE_SOLVER}" == mosek ]] || {
    echo "SDPX_REFERENCE_SOLVER must be clarabel or mosek" >&2
    exit 2
}

JULIA_BIN=${JULIA_BIN:-julia}
SHARED_ENV=$SDPX_SHARED_ENV
SHARED_DEPOT=$SDPX_SHARED_DEPOT
THREADS=${SDPX_THREADS:-1}
ALLOCATED=${PBS_NP:-32}
[[ "${THREADS}" =~ ^[0-9]+$ ]] || { echo "SDPX_THREADS must be an integer" >&2; exit 2; }
(( THREADS >= 1 && THREADS <= ALLOCATED )) || {
    echo "external solver threads (${THREADS}) exceed allocated slots (${ALLOCATED})" >&2
    exit 2
}
[[ -f "${SHARED_ENV}/Project.toml" ]] || {
    echo "missing instantiated shared environment: ${SHARED_ENV}" >&2
    exit 2
}

if [[ -n "${SDPX_COMPILER_PROFILE:-}" ]]; then
    source "${SDPX_COMPILER_PROFILE}"
fi
mkdir -p "${SDPX_OUTPUT_ROOT}"
JOB_DEPOT="${SDPX_JOB_DEPOT:-${SDPX_OUTPUT_ROOT}/.julia-depot}"
mkdir -p "${JOB_DEPOT}"
export JULIA_PROJECT="${SHARED_ENV}"
export JULIA_LOAD_PATH="${SHARED_ENV}:${SDPX_SOURCE}:${CSDR_RELEASE}:@stdlib"
export JULIA_DEPOT_PATH="${JOB_DEPOT}:${SHARED_DEPOT}"
export JULIA_PKG_OFFLINE=true
export JULIA_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export BLIS_NUM_THREADS=1

{
    echo "job_id=${PBS_JOBID:-interactive}"
    echo "node=$(hostname)"
    echo "requested_slots=${ALLOCATED}"
    echo "julia_threads=1"
    echo "external_solver=${SDPX_REFERENCE_SOLVER}"
    echo "external_solver_threads=${THREADS}"
    echo "blas_threads=1"
    echo "julia_bin=$(readlink -f "${JULIA_BIN}")"
    echo "job_depot=${JOB_DEPOT}"
    grep '^Cpus_allowed_list' /proc/self/status || true
    numactl --show 2>/dev/null || true
    lscpu | grep -E 'Model name|Socket|NUMA node' || true
} > "${SDPX_OUTPUT_ROOT}/resources.txt"

/usr/bin/time -v -o "${SDPX_OUTPUT_ROOT}/benchmark.time" \
    "${JULIA_BIN}" --startup-file=no --project="${SHARED_ENV}" -t 1 \
    "${SDPX_SOURCE}/docs/evidence/bench/soc_fixed_trace/reference/benchmark_float64.jl" \
    --case=J40 \
    --solver="${SDPX_REFERENCE_SOLVER}" \
    --model="${CSDR_MODEL}" \
    --release="${CSDR_RELEASE}" \
    --expected-hash="${SDPX_EXPECTED_HASH}" \
    --threads="${THREADS}" \
    --reps="${SDPX_REPS:-1}" \
    --warmup="${SDPX_WARMUP:-0}" \
    --tolerance="${SDPX_TOLERANCE:-1e-8}" \
    --max-iterations="${SDPX_MAX_ITERATIONS:-500}" \
    --time-limit-seconds="${SDPX_TIME_LIMIT_SECONDS:-7200}" \
    --quiet="${SDPX_REFERENCE_QUIET:-true}" \
    --output="${SDPX_OUTPUT_ROOT}/report.toml" \
    > "${SDPX_OUTPUT_ROOT}/benchmark.log" 2>&1

echo PASSED > "${SDPX_OUTPUT_ROOT}/PASSED"
