#!/usr/bin/env bash
#PBS -N sdpx_fixed_trace
#PBS -l nodes=1:ppn=32
#PBS -l mem=64gb
#PBS -l walltime=06:00:00
#PBS -j oe

# Portable single-configuration entry point.  All site paths are supplied via
# environment variables; no login-node modules, production directories, or
# mutable symlinks are touched by this template.
set -euo pipefail
: "${SDPX_SOURCE:?set SDPX_SOURCE to the isolated candidate source}"
HERE="$SDPX_SOURCE/docs/evidence/bench/soc_fixed_trace"
export SDPX_CASE="${SDPX_CASE:-J40}"
export SDPX_MODE="${SDPX_MODE:-socp}"
export SDPX_ARITHMETIC="${SDPX_ARITHMETIC:-Float64x4}"
export SDPX_THREADS="${SDPX_THREADS:-16}"
[[ "$SDPX_MODE" == sdp ]] && export SDPX_SCALING="${SDPX_SCALING:-none}" || export SDPX_SCALING=none
exec "$HERE/run_fixed_trace.sh"
