#!/bin/bash
#PBS -N sdpx_low08_soc
#PBS -l nodes=1:ppn=32
#PBS -l mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
[[ -n "${PBS_JOBID:-}" || "${ALLOW_INTERACTIVE:-0}" == 1 ]] || {
    echo "submit this regression on a PBS compute node" >&2
    exit 2
}
: "${SDPX_CANDIDATE:?set candidate source}"
: "${TASK_LOW08_INPUT:?set checksum-validated input}"
: "${OUTPUT_ROOT:?set isolated output root}"

JULIA=${CSDR_JULIA:-julia}
SHARED_DEPOT=${SDPX_SHARED_DEPOT:-${JULIA_DEPOT_PATH:-}}
DRIVER="${SDPX_CANDIDATE}/docs/evidence/bench/lattice_bootstrap/benchmark_sdpx_float64_solve.jl"
if [[ -n "${SDPX_COMPILER_PROFILE:-}" ]]; then
    source "${SDPX_COMPILER_PROFILE}"
fi
mkdir -p "${OUTPUT_ROOT}"
JOB_DEPOT="${SDPX_JOB_DEPOT:-${OUTPUT_ROOT}/.julia-depot}"
mkdir -p "${JOB_DEPOT}"
export JULIA_PROJECT="${SDPX_CANDIDATE}"
export JULIA_LOAD_PATH="${SDPX_CANDIDATE}:@stdlib"
export JULIA_DEPOT_PATH="${JOB_DEPOT}${SHARED_DEPOT:+:${SHARED_DEPOT}}"
export JULIA_PKG_OFFLINE=true
export JULIA_NUM_THREADS=16
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
ALLOCATED=${PBS_NP:-32}
(( 16 <= ALLOCATED )) || { echo "test threads exceed allocated slots" >&2; exit 2; }
export SDPX_MEMORY_LIMIT_BYTES=28GiB

{
    echo "job_id=${PBS_JOBID:-interactive}"
    echo "node=$(hostname)"
    echo "requested_slots=${PBS_NP:-unknown}"
    echo "julia_threads=16"
    echo "blas_threads=1"
    echo "job_depot=${JOB_DEPOT}"
    sha256sum "${TASK_LOW08_INPUT}"
    grep '^Cpus_allowed_list' /proc/self/status || true
    numactl --show 2>/dev/null || true
} > "${OUTPUT_ROOT}/resources.txt"

/usr/bin/time -v -o "${OUTPUT_ROOT}/task-low08.time" \
    numactl --interleave=all \
    "${JULIA}" --startup-file=no --project="${SDPX_CANDIDATE}" -t 16 \
    "${DRIVER}" "${TASK_LOW08_INPUT}" "${OUTPUT_ROOT}/task-low08.json" \
    16 600 0.1 0.9 1.0 1.0 classic 100 1e-6 adaptive auto auto auto \
    > "${OUTPUT_ROOT}/task-low08.log" 2>&1

grep -q '"status":"Optimal"' "${OUTPUT_ROOT}/task-low08.json"
echo PASSED > "${OUTPUT_ROOT}/PASSED"
