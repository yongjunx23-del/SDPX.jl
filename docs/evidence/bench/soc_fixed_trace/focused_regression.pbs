#!/bin/bash
#PBS -N sdpx_v04_focus
#PBS -l nodes=1:ppn=16
#PBS -l mem=24gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
[[ -n "${PBS_JOBID:-}" || "${ALLOW_INTERACTIVE:-0}" == 1 ]] || {
    echo "submit this regression on a PBS compute node" >&2
    exit 2
}
: "${SDPX_CANDIDATE:?set candidate source}"
: "${OUTPUT_ROOT:?set isolated output root}"
JULIA=${CSDR_JULIA:-julia}
SHARED_ENV=${SDPX_SHARED_ENV:?set an instantiated Julia environment}
SHARED_DEPOT=${SDPX_SHARED_DEPOT:-${JULIA_DEPOT_PATH:-}}
if [[ -n "${SDPX_COMPILER_PROFILE:-}" ]]; then
    source "${SDPX_COMPILER_PROFILE}"
fi
mkdir -p "${OUTPUT_ROOT}"
JOB_DEPOT="${SDPX_JOB_DEPOT:-${OUTPUT_ROOT}/.julia-depot}"
mkdir -p "${JOB_DEPOT}"
[[ -f "${SHARED_ENV}/Project.toml" ]] || {
    echo "missing instantiated shared environment: ${SHARED_ENV}" >&2
    exit 2
}
# The benchmark Manifest is intentionally not versioned. Reuse the pinned
# cluster environment for third-party packages, then resolve SDPX from the
# isolated candidate package directory. This is the same dependency order as
# the production benchmark launcher and avoids testing a cached old candidate.
export JULIA_PROJECT="${SHARED_ENV}"
export JULIA_LOAD_PATH="${SHARED_ENV}:${SDPX_CANDIDATE}:@stdlib"
export JULIA_DEPOT_PATH="${JOB_DEPOT}${SHARED_DEPOT:+:${SHARED_DEPOT}}"
export JULIA_PKG_OFFLINE=true
export JULIA_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
ALLOCATED=${PBS_NP:-16}
(( 4 <= ALLOCATED )) || { echo "test threads exceed allocated slots" >&2; exit 2; }

{
    echo "job_id=${PBS_JOBID:-interactive}"
    echo "node=$(hostname)"
    echo "requested_slots=${PBS_NP:-unknown}"
    echo "julia_threads=4"
    echo "blas_threads=1"
    echo "job_depot=${JOB_DEPOT}"
} > "${OUTPUT_ROOT}/resources.txt"

/usr/bin/time -v -o "${OUTPUT_ROOT}/focused-test.time" \
    "${JULIA}" --startup-file=no --project="${SHARED_ENV}" -t 4 \
    -e 'using SDPX; actual = realpath(dirname(dirname(pathof(SDPX)))); expected = realpath(ENV["SDPX_CANDIDATE"]); actual == expected || error("loaded SDPX from $actual, expected $expected"); using Test; include(joinpath(expected, "test", "lp_regressions.jl")); include(joinpath(expected, "test", "soc_regressions.jl")); include(joinpath(expected, "test", "public_api.jl"))' \
    > "${OUTPUT_ROOT}/focused-test.log" 2>&1

echo PASSED > "${OUTPUT_ROOT}/PASSED"
