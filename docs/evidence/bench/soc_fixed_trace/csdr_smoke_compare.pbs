#!/bin/bash
#PBS -N sdpx_csdr_soc
# Reserve a wide placement while keeping the measured solver thread count
# explicit. This avoids landing short validation runs on saturated nodes.
#PBS -l nodes=1:ppn=32
#PBS -l mem=64gb
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

: "${SDPX_CANDIDATE:?set the isolated candidate source directory}"
: "${SDPX_BASELINE_ENV:?set the validated production environment}"
: "${CSDR_RELEASE:?set the immutable CSDR release}"
: "${CSDR_MODEL:?set the serialized spectral-primal smoke model}"
: "${OUTPUT_ROOT:?set an isolated output directory}"

JULIA=${CSDR_JULIA:-julia}
DEPOT=${SDPX_SHARED_DEPOT:-${JULIA_DEPOT_PATH:-}}
DRIVER="${CSDR_RELEASE}/scripts/benchmark_functional_arrow.jl"
DETAILED_DRIVER="${SDPX_CANDIDATE}/docs/evidence/bench/soc_fixed_trace/csdr_detailed.jl"
DETAILED=${CSDR_DETAILED:-false}
THREADS=${SDPX_THREADS:-16}

[[ "$THREADS" =~ ^[0-9]+$ ]] || { echo "SDPX_THREADS must be an integer" >&2; exit 2; }
ALLOCATED=${PBS_NP:-32}
(( THREADS >= 1 && THREADS <= ALLOCATED )) || {
    echo "solver threads ($THREADS) exceed allocated slots ($ALLOCATED)" >&2
    exit 2
}
[[ -n "${PBS_JOBID:-}" || "${ALLOW_INTERACTIVE:-0}" == 1 ]] || {
    echo "submit this comparison on a PBS compute node" >&2
    exit 2
}

if [[ -n "${SDPX_COMPILER_PROFILE:-}" ]]; then
    source "${SDPX_COMPILER_PROFILE}"
fi
mkdir -p "${OUTPUT_ROOT}"
JOB_DEPOT="${SDPX_JOB_DEPOT:-${OUTPUT_ROOT}/.julia-depot}"
mkdir -p "${JOB_DEPOT}"
export JULIA_DEPOT_PATH="${JOB_DEPOT}${DEPOT:+:${DEPOT}}"
export JULIA_PKG_OFFLINE=true
export JULIA_NUM_THREADS="${THREADS}"
export SDPX_THREADS="${THREADS}"
export SDPX_NUM_THREADS="${THREADS}"
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export CSDR_BLAS_THREADS=1

{
    echo "job_id=${PBS_JOBID:-interactive}"
    echo "node=$(hostname)"
    echo "requested_slots=${PBS_NP:-unknown}"
    echo "solver_threads=${THREADS}"
    echo "blas_threads=1"
    echo "job_depot=${JOB_DEPOT}"
    grep '^Cpus_allowed_list' /proc/self/status || true
    numactl --show 2>/dev/null || true
    lscpu | grep -E 'Model name|Socket|NUMA node' || true
} > "${OUTPUT_ROOT}/resources.txt"

run_one() {
    local label=$1
    local project=$2
    local load_path=$3
    export JULIA_PROJECT="${project}"
    export JULIA_LOAD_PATH="${load_path}:@stdlib"
    if [[ "${DETAILED}" == true ]]; then
        /usr/bin/time -v -o "${OUTPUT_ROOT}/${label}.time" \
            "${JULIA}" --startup-file=no --project="${project}" -t "${THREADS}" \
            "${DETAILED_DRIVER}" "${CSDR_RELEASE}" "${CSDR_MODEL}" \
            "${OUTPUT_ROOT}/${label}.toml" 3 \
            > "${OUTPUT_ROOT}/${label}.log" 2>&1
    else
        /usr/bin/time -v -o "${OUTPUT_ROOT}/${label}.time" \
            "${JULIA}" --startup-file=no --project="${project}" -t "${THREADS}" \
            "${DRIVER}" spectral "${CSDR_MODEL}" \
            "${OUTPUT_ROOT}/${label}.toml" 3 \
            > "${OUTPUT_ROOT}/${label}.log" 2>&1
    fi
}

# Run production first and the candidate second on the same allocation. Each
# driver performs one warm-up plus three measured solves.
run_one baseline "${SDPX_BASELINE_ENV}" "${SDPX_BASELINE_ENV}:${CSDR_RELEASE}"
run_one candidate "${SDPX_CANDIDATE}" "${SDPX_CANDIDATE}:${CSDR_RELEASE}"

echo PASSED > "${OUTPUT_ROOT}/PASSED"
