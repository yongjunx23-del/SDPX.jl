#!/usr/bin/env bash
#PBS -N sdpx_j40_sdp
#PBS -l nodes=1:ppn=32
#PBS -l mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe

# One fixed thread configuration per allocation.  Submit a separate job for
# every scaling point; never change -t inside this process.
set -euo pipefail
: "${SDPX_SOURCE:?set SDPX_SOURCE to the isolated candidate source}"
HERE="$SDPX_SOURCE/docs/evidence/bench/soc_fixed_trace"
export SDPX_CASE=J40
export SDPX_MODE=sdp
export SDPX_ARITHMETIC="${SDPX_ARITHMETIC:-Float64x4}"
export SDPX_THREADS="${SDPX_THREADS:-32}"
export SDPX_THREAD_POLICY="${SDPX_THREAD_POLICY:-exclusive}"
export SDPX_SCALING="${SDPX_SCALING:-none}"
exec "$HERE/run_fixed_trace.sh"
