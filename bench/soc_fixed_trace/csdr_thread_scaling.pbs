#!/usr/bin/env bash
#PBS -N sdpx_csdr_scale_point
#PBS -l nodes=1:ppn=32
#PBS -l mem=64gb
#PBS -l walltime=03:00:00
#PBS -j oe

# One scaling point per job.  Submit an array or resubmit with another
# SDPX_THREADS value; changing Julia's thread count inside one process would
# mix compilation and allocator state across points.
set -euo pipefail
: "${SDPX_SOURCE:?set SDPX_SOURCE to the isolated candidate source}"
HERE="$SDPX_SOURCE/bench/soc_fixed_trace"
export SDPX_CASE="${SDPX_CASE:-J40}"
export SDPX_MODE="${SDPX_MODE:-socp}"
export SDPX_ARITHMETIC="${SDPX_ARITHMETIC:-Float64x4}"
export SDPX_THREADS="${SDPX_THREADS:-16}"
export SDPX_SCALING=none
exec "$HERE/run_fixed_trace.sh"
