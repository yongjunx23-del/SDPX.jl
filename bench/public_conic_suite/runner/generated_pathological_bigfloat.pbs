#!/bin/bash
#PBS -N sdpx_generated_p0_bigfloat
#PBS -q sugon
#PBS -l nodes=1:ppn=1
#PBS -l mem=8gb
#PBS -l walltime=24:00:00
#PBS -j oe

# Generated pathological P0, bigfloat resource class.
# PBS ppn=1; Julia threads 1; solver threads 1; BLAS threads 1.
set -euo pipefail

: "${SDPX_SOURCE:?set SDPX_SOURCE to the immutable candidate checkout}"
: "${SDPX_RESULT_DIR:?set SDPX_RESULT_DIR to a unique result directory}"
: "${SDPX_SITE_ENV:?set SDPX_SITE_ENV to the site environment script}"
: "${SDPX_ENVIRONMENT:?set SDPX_ENVIRONMENT to the matching Julia environment}"
: "${SDPX_DEPOT_PATH:?set SDPX_DEPOT_PATH to the offline Julia depot}"
: "${NODE_NAME:?set NODE_NAME to the pinned compute node}"

source "$SDPX_SITE_ENV"
: "${JULIA_BIN:?set JULIA_BIN directly or through SDPX_SITE_ENV}"

ACTUAL_NODE="$(hostname)"
if [ "$ACTUAL_NODE" != "$NODE_NAME" ]; then
  echo "NODE_NAME guard failed: $ACTUAL_NODE != $NODE_NAME" >&2
  exit 1
fi
if [ -e "$SDPX_RESULT_DIR" ]; then
  echo "SDPX_RESULT_DIR already exists; refusing to mutate an existing result path: $SDPX_RESULT_DIR" >&2
  exit 1
fi
mkdir -p "$SDPX_RESULT_DIR"

export JULIA_PKG_OFFLINE=true
export JULIA_DEPOT_PATH="$SDPX_DEPOT_PATH"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export BLIS_NUM_THREADS=1
export SDPX_RESOURCE_CLASS=bigfloat
export SDPX_ARITHMETIC="${SDPX_ARITHMETIC:-bigfloat256}"
export SDPX_REPETITIONS="${SDPX_REPETITIONS:-1}"
export SDPX_TIME_LIMIT="${SDPX_TIME_LIMIT:-3600}"
export SDPX_MAX_ITERATIONS="${SDPX_MAX_ITERATIONS:-300}"
export SDPX_WARMUP="${SDPX_WARMUP:-1}"

{
  printf 'pbs_job_id=%s\n' "$PBS_JOBID"
  printf 'host=%s\n' "$(hostname)"
  printf 'reserved_cores=%s\n' "${PBS_NP:-1}"
  printf 'source=%s\n' "$SDPX_SOURCE"
  printf 'resource_class=%s\n' "$SDPX_RESOURCE_CLASS"
  printf 'arithmetic=%s\n' "$SDPX_ARITHMETIC"
  printf 'julia_version=%s\n' "$("$JULIA_BIN" --version 2>/dev/null | head -n 1)"
  lscpu | grep -E 'Model name|Socket|NUMA|CPU\(s\)' || true
} > "$SDPX_RESULT_DIR/environment.txt"

WARMUP_FLAG="--warmup=$SDPX_WARMUP"

/usr/bin/time -v -o "$SDPX_RESULT_DIR/process.time.txt" \
  "$JULIA_BIN" \
  --project="$SDPX_ENVIRONMENT" \
  --startup-file=no \
  -t 1 \
  "$SDPX_SOURCE/bench/public_conic_suite/runner/run_generated_pathological.jl" \
  --source="$SDPX_SOURCE" \
  --output="$SDPX_RESULT_DIR" \
  --resource-class=bigfloat \
  --arithmetic="$SDPX_ARITHMETIC" \
  --repetitions="$SDPX_REPETITIONS" \
  --time-limit="$SDPX_TIME_LIMIT" \
  --max-iterations="$SDPX_MAX_ITERATIONS" \
  $WARMUP_FLAG \
  | tee "$SDPX_RESULT_DIR/runner.log"
