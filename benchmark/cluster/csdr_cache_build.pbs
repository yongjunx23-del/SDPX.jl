#!/usr/bin/env bash
# Build one immutable maximal-alpha cache for a (J,N_mu) geometry.
#
# The launcher submits this as an array over the build manifest. The resource
# request is intentionally the conservative large64 class because construction
# is the phase with the least reliable memory extrapolation.
#PBS -N csdr-cache-build
#PBS -q normal
#PBS -l nodes=1:ppn=16
#PBS -l mem=224gb
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?qsub must export CAMPAIGN_ROOT}"
: "${SDPX_SOURCE_ROOT:?qsub must export SDPX_SOURCE_ROOT}"
: "${SDPX_ENV_ROOT:?qsub must export SDPX_ENV_ROOT}"
: "${SDPX_DEPLOYED_COMMIT:?qsub must export SDPX_DEPLOYED_COMMIT}"
: "${MFLA_DEPLOYED_COMMIT:?qsub must export MFLA_DEPLOYED_COMMIT}"
: "${CSDR_SOURCE_TREE_SHA256:?qsub must export CSDR_SOURCE_TREE_SHA256}"
[[ "$SDPX_DEPLOYED_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || exit 3
[[ "$MFLA_DEPLOYED_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || exit 3
[[ "$CSDR_SOURCE_TREE_SHA256" =~ ^[0-9a-fA-F]{64}$ ]] || exit 3
readonly CSDR_SOURCE_ROOT="${CSDR_SOURCE_ROOT:-$CAMPAIGN_ROOT/csdr-source}"

readonly MANIFEST="${CSDR_BUILD_MANIFEST:-}"
readonly ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}"

if [[ -n "$MANIFEST" ]]; then
    : "${ARRAY_INDEX:?array build requires PBS_ARRAY_INDEX/PBS_ARRAYID}"
    row=$(sed -n "$((ARRAY_INDEX + 2))p" "$MANIFEST")
    [[ -n "$row" ]] || { echo "missing build manifest row $ARRAY_INDEX" >&2; exit 2; }
    IFS=$'\t' read -r phase stage case_id j na nmu alpha_level alpha_count frontier_max_count \
        predicted_peak_gib nred solver_threads resource_class requested_cores memory_gb walltime \
        cache_alpha_level cache_alpha_count cache_rel result_rel build_rel predecessor_key <<< "$row"
    [[ "$phase" == build ]] || { echo "manifest row is not a build row: $phase" >&2; exit 2; }
    export CSDR_J="$j" CSDR_N_A="$na" CSDR_N_MU="$nmu"
    export CSDR_CACHE_ALPHA_LEVEL="$cache_alpha_level" CSDR_CACHE_ALPHA_COUNT="$cache_alpha_count" CSDR_CACHE_REL="$cache_rel"
    export CSDR_BUILD_REL="$build_rel"
else
    : "${CSDR_J:?set CSDR_J or CSDR_BUILD_MANIFEST}"
    : "${CSDR_N_MU:?set CSDR_N_MU or CSDR_BUILD_MANIFEST}"
    CSDR_N_A="${CSDR_N_A:-$((3 * CSDR_J / 8))}"
    case "${CSDR_J}:${CSDR_N_MU}" in
        40:400|40:800|40:1600|40:3200|80:400|80:800|80:1600|160:400) CSDR_CACHE_ALPHA_COUNT=33 ;;
        80:3200|160:800) CSDR_CACHE_ALPHA_COUNT=17 ;;
        160:1600|320:400) CSDR_CACHE_ALPHA_COUNT=9 ;;
        160:3200|320:800) CSDR_CACHE_ALPHA_COUNT=5 ;;
        320:1600) CSDR_CACHE_ALPHA_COUNT=3 ;;
        320:3200) CSDR_CACHE_ALPHA_COUNT=2 ;;
        *) echo "unsupported frontier for J=${CSDR_J} N_mu=${CSDR_N_MU}" >&2; exit 2 ;;
    esac
    CSDR_CACHE_ALPHA_LEVEL="${CSDR_CACHE_ALPHA_LEVEL:-1}"
    case "$CSDR_CACHE_ALPHA_COUNT" in 2) CSDR_CACHE_ALPHA_LEVEL=1 ;; 3) CSDR_CACHE_ALPHA_LEVEL=2 ;; 5) CSDR_CACHE_ALPHA_LEVEL=3 ;; 9) CSDR_CACHE_ALPHA_LEVEL=4 ;; 17) CSDR_CACHE_ALPHA_LEVEL=5 ;; 33) CSDR_CACHE_ALPHA_LEVEL=6 ;; *) exit 2 ;; esac
    CSDR_CACHE_REL="${CSDR_CACHE_REL:-cache/j${CSDR_J}/nmu${CSDR_N_MU}/alpha${CSDR_CACHE_ALPHA_COUNT}.bin}"
    CSDR_BUILD_REL="${CSDR_BUILD_REL:-build/j${CSDR_J}/nmu${CSDR_N_MU}/alpha${CSDR_CACHE_ALPHA_COUNT}}"
fi

case "$CSDR_J" in 40|80|160|320) ;; *) echo "unsupported J: $CSDR_J" >&2; exit 2 ;; esac
case "$CSDR_N_MU" in 400|800|1600|3200) ;; *) echo "unsupported N_mu: $CSDR_N_MU" >&2; exit 2 ;; esac
case "$CSDR_CACHE_ALPHA_LEVEL" in 1|2|3|4|5|6) ;; *) echo "unsupported cache alpha level" >&2; exit 2 ;; esac
case "$CSDR_CACHE_ALPHA_COUNT" in 2|3|5|9|17|33) ;; *) echo "unsupported cache alpha count" >&2; exit 2 ;; esac
expected_cache_count=$(( (1 << (CSDR_CACHE_ALPHA_LEVEL - 1)) + 1 ))
((CSDR_CACHE_ALPHA_COUNT == expected_cache_count)) || { echo "cache alpha count does not match level" >&2; exit 2; }
((CSDR_N_A == 3 * CSDR_J / 8)) || { echo "N_a must equal 3*J/8" >&2; exit 2; }

allocated_slots=$(wc -l < "${PBS_NODEFILE:-/dev/null}" 2>/dev/null || echo 0)
(( allocated_slots >= 16 )) || {
    echo "cache construction requires at least 16 slots (got $allocated_slots)" >&2
    exit 2
}

readonly SHARED_ROOT="${CSDR_SHARED_ROOT:-/public/home/yongjunxu/projects/csdr-clarabel-multifloat}"
readonly JULIA_BIN="${JULIA_BIN:-$SHARED_ROOT/julia/julia-1.12.6/bin/julia}"
readonly DRIVER="${CSDR_DRIVER:-$CAMPAIGN_ROOT/driver/g0_max_bigfloat256_float64x2.jl}"
readonly CACHE="$CAMPAIGN_ROOT/$CSDR_CACHE_REL"
readonly BUILD_ROOT="$CAMPAIGN_ROOT/$CSDR_BUILD_REL"
readonly CACHE_TMP="$CACHE.part.${PBS_JOBID:-$$}"
readonly N_X="${CSDR_N_X:-1}"
readonly BUILD_NODE_MEMORY_GB="${CSDR_BUILD_NODE_MEMORY_GB:-176}"

test -x "$JULIA_BIN"
test -f "$DRIVER"
test -f "$SDPX_SOURCE_ROOT/Project.toml"
test -d "$SDPX_SOURCE_ROOT/ext"
test -f "$SDPX_ENV_ROOT/Project.toml"
test -f "$SDPX_ENV_ROOT/Manifest.toml"
test -f "$CSDR_SOURCE_ROOT/src/csdr_model.jl"

mkdir -p "$BUILD_ROOT" "$(dirname "$CACHE")"
if [[ -e "$CACHE" || -e "$BUILD_ROOT/BUILD_COMPLETE" || -e "$BUILD_ROOT/resource_frontier.toml" ]]; then
    if [[ -f "$CACHE" && -f "$BUILD_ROOT/BUILD_COMPLETE" && -f "$BUILD_ROOT/cache.sha256" ]]; then
        [[ -s "$BUILD_ROOT/provenance.txt" ]] || {
            echo "immutable cache is missing provenance: $BUILD_ROOT" >&2
            exit 3
        }
        grep -q "^sdpx_deployed_commit=$SDPX_DEPLOYED_COMMIT$" "$BUILD_ROOT/provenance.txt" || {
            echo "immutable cache SDPX identity differs from requested release" >&2
            exit 3
        }
        grep -q "^mfla_commit=$MFLA_DEPLOYED_COMMIT$" "$BUILD_ROOT/provenance.txt" || {
            echo "immutable cache MFLA identity differs from requested release" >&2
            exit 3
        }
        grep -q "^csdr_source_tree_sha256=$CSDR_SOURCE_TREE_SHA256$" "$BUILD_ROOT/provenance.txt" || {
            echo "immutable cache CSDR source identity differs from requested release" >&2
            exit 3
        }
        existing_expected=$(awk 'NR == 1 {print $1}' "$BUILD_ROOT/cache.sha256")
        existing_actual=$(sha256sum "$CACHE" | awk '{print $1}')
        [[ -n "$existing_expected" && "$existing_expected" == "$existing_actual" ]] || {
            echo "immutable cache digest mismatch: $CACHE" >&2
            exit 3
        }
        echo "reusing immutable cache: $CACHE"
        exit 0
    fi
    if [[ -f "$BUILD_ROOT/resource_frontier.toml" ]]; then
        echo "reusing recorded resource frontier: $BUILD_ROOT/resource_frontier.toml"
        exit 0
    fi
    echo "refusing to overwrite immutable cache: $CACHE" >&2
    exit 3
fi
test ! -e "$CACHE_TMP"

export JULIA_NUM_THREADS=16
export JULIA_DEPOT_PATH="${JULIA_DEPOT_PATH:-$SHARED_ROOT/depot}"
export JULIA_PROJECT="$SDPX_ENV_ROOT"
export JULIA_LOAD_PATH="$SDPX_ENV_ROOT:@stdlib"
export JULIA_PKG_OFFLINE=true
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export CSDR_SOURCE_ROOT
export SDPX_SOURCE_ROOT
: "${MFLA_DEPLOYED_COMMIT:?MFLA_DEPLOYED_COMMIT must come from immutable release metadata}"
[[ "$MFLA_DEPLOYED_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || {
    echo "MFLA_DEPLOYED_COMMIT must be a validated 40-hex commit" >&2
    exit 3
}

source /public/software/profile.d/compiler_gcc_11.sh

deployed_commit="${SDPX_DEPLOYED_COMMIT:-}"
if [[ -z "$deployed_commit" && -f "$CAMPAIGN_ROOT/DEPLOYED_GIT_HEAD" ]]; then
    deployed_commit=$(tr -d '[:space:]' < "$CAMPAIGN_ROOT/DEPLOYED_GIT_HEAD")
fi
[[ "$deployed_commit" =~ ^[0-9a-fA-F]{40}$ ]] || {
    echo "SDPX_DEPLOYED_COMMIT must be a validated 40-hex release commit" >&2
    exit 3
}
if sdpx_head=$(git -C "$SDPX_SOURCE_ROOT" rev-parse HEAD 2>/dev/null); then
    [[ -z "$(git -C "$SDPX_SOURCE_ROOT" status --porcelain --untracked-files=all)" ]] || {
        echo "refusing dirty SDPX_SOURCE_ROOT" >&2
        exit 3
    }
    [[ "$deployed_commit" == "$sdpx_head" ]] || {
        echo "SDPX_DEPLOYED_COMMIT does not match SDPX_SOURCE_ROOT HEAD" >&2
        exit 3
    }
    sdpx_commit="$sdpx_head"
else
    # Archive releases may omit .git; the validated release commit and source
    # fingerprints are the immutable identity in that deployment mode.
    sdpx_commit="$deployed_commit"
fi
if [[ -n "${CSDR_EXPECTED_SDPX_COMMIT:-}" ]]; then
    [[ "$sdpx_commit" == "$CSDR_EXPECTED_SDPX_COMMIT" ]] || {
        echo "SDPX commit $sdpx_commit != expected $CSDR_EXPECTED_SDPX_COMMIT" >&2
        exit 3
    }
fi
sdpx_source_tree_sha256=$(cd "$SDPX_SOURCE_ROOT" && \
    while IFS= read -r rel; do
        printf '%s:' "$rel"
        sha256sum "$rel" | awk '{print $1}'
        printf '\n'
    done < <({ find src ext -type f -name '*.jl' -print; printf '%s\n' Project.toml; } | LC_ALL=C sort -u) | sha256sum | awk '{print $1}')
[[ "$sdpx_source_tree_sha256" =~ ^[0-9a-fA-F]{64}$ ]] || exit 3
csdr_tree_sha256=$(cd "$CSDR_SOURCE_ROOT" && \
    while IFS= read -r rel; do
        printf '%s:' "$rel"
        sha256sum "$rel" | awk '{print $1}'
        printf '\n'
    done < <(find src -type f -name '*.jl' -print | LC_ALL=C sort) | sha256sum | awk '{print $1}')
[[ "$csdr_tree_sha256" =~ ^[0-9a-fA-F]{64}$ ]] || {
    echo "CSDR source tree hash is not 64-hex" >&2
    exit 3
}
if [[ -n "${CSDR_SOURCE_TREE_SHA256:-}" &&
      "${CSDR_SOURCE_TREE_SHA256}" != "$csdr_tree_sha256" ]]; then
    echo "CSDR_SOURCE_TREE_SHA256 does not match CSDR_SOURCE_ROOT" >&2
    exit 3
fi
CSDR_SOURCE_TREE_SHA256="$csdr_tree_sha256"
export SDPX_DEPLOYED_COMMIT="$deployed_commit" MFLA_DEPLOYED_COMMIT
export CSDR_SOURCE_TREE_SHA256
active_project=$("$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    -e 'print(Base.active_project())')
[[ "$active_project" == "$SDPX_ENV_ROOT/Project.toml" ]] || {
    echo "active Julia project does not match SDPX_ENV_ROOT: $active_project" >&2
    exit 3
}
active_sdpx=$("$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    -e 'using SDPX; print(pathof(SDPX))')
case "$active_sdpx" in
    "$SDPX_SOURCE_ROOT"/*) ;;
    *) echo "active SDPX package path does not match SDPX_SOURCE_ROOT: $active_sdpx" >&2; exit 3 ;;
esac

readonly SOURCE_HASHES="$BUILD_ROOT/source.sha256"
readonly DRIVER_SHA256=$(sha256sum "$DRIVER" | awk '{print $1}')
{
    sha256sum "$DRIVER" "$SDPX_SOURCE_ROOT/Project.toml" \
        "$SDPX_ENV_ROOT/Project.toml" "$SDPX_ENV_ROOT/Manifest.toml"
    while IFS= read -r rel; do
        (cd "$SDPX_SOURCE_ROOT" && sha256sum "$rel")
    done < <(cd "$SDPX_SOURCE_ROOT" && find src ext -type f -name '*.jl' -print | LC_ALL=C sort)
    while IFS= read -r rel; do
        (cd "$CSDR_SOURCE_ROOT" && sha256sum "$rel")
    done < <(cd "$CSDR_SOURCE_ROOT" && find src -type f -name '*.jl' -print | LC_ALL=C sort)
} > "$SOURCE_HASHES"

provenance="$BUILD_ROOT/provenance.txt"
{
    echo "phase=build-cache"
    echo "pbs_jobid=${PBS_JOBID:-manual}"
    echo "hostname=$(hostname)"
    echo "allocated_slots=$allocated_slots"
    echo "julia_threads=$JULIA_NUM_THREADS"
    echo "J=$CSDR_J"
    echo "N_a=$CSDR_N_A"
    echo "N_mu=$CSDR_N_MU"
    echo "alpha_level=$CSDR_CACHE_ALPHA_LEVEL"
    echo "alpha_count=$CSDR_CACHE_ALPHA_COUNT"
    echo "construction_memory_cap_gb=$BUILD_NODE_MEMORY_GB"
    echo "sdpx_source_root=$SDPX_SOURCE_ROOT"
    echo "sdpx_env_root=$SDPX_ENV_ROOT"
    echo "sdpx_commit=$sdpx_commit"
    echo "sdpx_source_tree_sha256=$sdpx_source_tree_sha256"
    echo "sdpx_deployed_commit=$deployed_commit"
    echo "mfla_commit=$MFLA_DEPLOYED_COMMIT"
    echo "csdr_source_tree_sha256=$csdr_tree_sha256"
    echo "driver_sha256=$DRIVER_SHA256"
    echo "orchestration_owner=SDPX"
    echo "la_planned_provider=multifloat_linear_algebra"
    echo "la_executed_provider=not_executed"
    echo "fallback_reason=none"
    echo "la_fallback_reason=none"
    echo "active_project=$active_project"
    echo "active_sdpx=$active_sdpx"
    echo "source_hash_file=$SOURCE_HASHES"
    echo "started_utc=$(date -u +%FT%TZ)"
} > "$provenance"

command=(
    "$JULIA_BIN"
    --startup-file=no
    --project="$SDPX_ENV_ROOT"
    "$DRIVER"
    --mode=build-cache
    --cache="$CACHE_TMP"
    --output="$BUILD_ROOT/build.toml"
    --J="$CSDR_J"
    --N_x="$N_X"
    --n-mu="$CSDR_N_MU"
    --n-a="$CSDR_N_A"
    --alpha-level="$CSDR_CACHE_ALPHA_LEVEL"
    --precompute-bits=256
    --node-memory-gb="$BUILD_NODE_MEMORY_GB"
    --tolerance=1e-6
    --maximum-iterations=250
    --maximum-time=165600
    --solver-threads=16
    --warmup-iterations=0
    --verbosity=0
)

if ! /usr/bin/time -v -o "$BUILD_ROOT/time.txt" "${command[@]}" > "$BUILD_ROOT/stdout" 2> "$BUILD_ROOT/stderr"; then
    if grep -Eqi 'frontier|memory|node-memory|exceeds' "$BUILD_ROOT/stderr"; then
        frontier_tmp="$BUILD_ROOT/resource_frontier.toml.part.${PBS_JOBID:-$$}"
        {
            echo 'status="unresolved_at_resource_frontier"'
            echo "J=$CSDR_J"
            echo "N_mu=$CSDR_N_MU"
            echo "requested_alpha_level=$CSDR_CACHE_ALPHA_LEVEL"
            echo "requested_alpha_count=$CSDR_CACHE_ALPHA_COUNT"
            echo "construction_memory_cap_gb=$BUILD_NODE_MEMORY_GB"
            echo "frontier_evidence=$BUILD_ROOT/stderr"
            echo "sdpx_commit=$sdpx_commit"
            echo "mfla_commit=$MFLA_DEPLOYED_COMMIT"
            echo "csdr_source_tree_sha256=$csdr_tree_sha256"
            echo "recorded_utc=$(date -u +%FT%TZ)"
        } > "$frontier_tmp"
        mv "$frontier_tmp" "$BUILD_ROOT/resource_frontier.toml"
        # A recorded frontier is a completed adaptive decision, not a
        # transient PBS failure; allow the dependent solve to fail fast on the
        # missing cache so validation/controller can report the state.
        exit 0
    fi
    exit 1
fi
rss_kib=$(awk -F: '/Maximum resident set size/ {gsub(/[^0-9]/,"",$2); print $2}' "$BUILD_ROOT/time.txt" | tail -n1)
peak_rss_bytes=$(( ${rss_kib:-0} * 1024 ))
echo "peak_rss_bytes=$peak_rss_bytes" >> "$provenance"
if ((peak_rss_bytes > BUILD_NODE_MEMORY_GB * 1024 * 1024 * 1024)); then
    frontier_tmp="$BUILD_ROOT/resource_frontier.toml.part.${PBS_JOBID:-$$}"
    { echo 'status="unresolved_at_resource_frontier"'; echo "peak_rss_bytes=$peak_rss_bytes"; echo "memory_cap_gb=$BUILD_NODE_MEMORY_GB"; } > "$frontier_tmp"
    mv "$frontier_tmp" "$BUILD_ROOT/resource_frontier.toml"
    exit 0
fi
test -s "$CACHE_TMP"
mv "$CACHE_TMP" "$CACHE"
sha256sum "$CACHE" > "$BUILD_ROOT/cache.sha256.part"
mv "$BUILD_ROOT/cache.sha256.part" "$BUILD_ROOT/cache.sha256"
echo "cache_bytes=$(wc -c < "$CACHE")" >> "$provenance"
echo "cache_sha256=$(awk '{print $1}' "$BUILD_ROOT/cache.sha256")" >> "$provenance"
echo "finished_utc=$(date -u +%FT%TZ)" >> "$provenance"
echo "completed=true" >> "$provenance"
touch "$BUILD_ROOT/BUILD_COMPLETE"
