#!/usr/bin/env bash
# Cluster-only orchestration and release gate.  This job is intentionally
# bounded and must run on a compute node in the pinned Julia environment; it
# is never a substitute for the production PBS campaign.
#PBS -N csdr-campaign-tests
#PBS -q normal
#PBS -l nodes=1:ppn=8
#PBS -l mem=8gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

: "${SDPX_ENV_ROOT:?qsub must export SDPX_ENV_ROOT}"
: "${SDPX_SOURCE_ROOT:?qsub must export SDPX_SOURCE_ROOT}"
: "${CSDR_SOURCE_ROOT:?qsub must export CSDR_SOURCE_ROOT}"
: "${SDPX_DEPLOYED_COMMIT:?qsub must export SDPX_DEPLOYED_COMMIT}"
: "${MFLA_DEPLOYED_COMMIT:?qsub must export MFLA_DEPLOYED_COMMIT}"
: "${CSDR_SOURCE_TREE_SHA256:?qsub must export CSDR_SOURCE_TREE_SHA256}"
[[ "$SDPX_DEPLOYED_COMMIT" =~ ^[0-9a-f]{40}$ ]] || exit 2
[[ "$MFLA_DEPLOYED_COMMIT" =~ ^[0-9a-f]{40}$ ]] || exit 2
[[ "$CSDR_SOURCE_TREE_SHA256" =~ ^[0-9a-f]{64}$ ]] || exit 2

# Torque/PBS executes a private spool copy of this file, so BASH_SOURCE points
# at the spool directory rather than the immutable release. Resolve every
# companion path from the explicitly pinned source root instead.
readonly RELEASE_ROOT="${CSDR_RELEASE_ROOT:-$SDPX_SOURCE_ROOT}"
readonly SCRIPT_DIR="$RELEASE_ROOT/benchmark/cluster"
readonly MANIFEST_TOOL="$SCRIPT_DIR/csdr_campaign_manifest.sh"
readonly JULIA_BIN="${JULIA_BIN:-/public/home/yongjunxu/projects/csdr-clarabel-multifloat/julia/julia-1.12.6/bin/julia}"
readonly DRIVER="${CSDR_DRIVER:-$RELEASE_ROOT/benchmark/bootstrap/Full-unitraity-EFT/g0_max_bigfloat256_float64x2.jl}"
readonly CONVERGENCE_CLI="${CSDR_CONTROLLER:-$RELEASE_ROOT/benchmark/bootstrap/Full-unitraity-EFT/csdr_convergence_cli.jl}"
readonly CONVERGENCE_TEST="${CSDR_CONVERGENCE_TEST:-$RELEASE_ROOT/test/csdr_convergence.jl}"
readonly CACHE_TEST="${CSDR_CACHE_CONTRACT_TEST:-$RELEASE_ROOT/test/csdr_cache_contract.jl}"

test -x "$JULIA_BIN"
test -f "$DRIVER"
test -f "$CONVERGENCE_CLI"
test -f "$CONVERGENCE_TEST"
test -f "$MANIFEST_TOOL"
test -f "$SDPX_SOURCE_ROOT/Project.toml"
test -f "$CSDR_SOURCE_ROOT/src/csdr_model.jl"
source /public/software/profile.d/compiler_gcc_11.sh
export JULIA_PROJECT="$SDPX_ENV_ROOT" JULIA_PKG_OFFLINE=true
export JULIA_DEPOT_PATH="${JULIA_DEPOT_PATH:-/public/home/yongjunxu/projects/csdr-clarabel-multifloat/depot}"
export JULIA_LOAD_PATH="$SDPX_ENV_ROOT:@stdlib"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
export SDPX_SOURCE_ROOT CSDR_SOURCE_ROOT SDPX_DEPLOYED_COMMIT MFLA_DEPLOYED_COMMIT CSDR_SOURCE_TREE_SHA256

active_sdpx=$("$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    -e 'using SDPX; print(pathof(SDPX))')
case "$active_sdpx" in
    "$SDPX_SOURCE_ROOT"/*) ;;
    *) echo "active SDPX package path does not match release: $active_sdpx" >&2; exit 3 ;;
esac
active_project=$("$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    -e 'print(Base.active_project())')
[[ "$active_project" == "$SDPX_ENV_ROOT/Project.toml" ]] || {
    echo "active Julia project does not match pinned environment: $active_project" >&2
    exit 3
}
actual_csdr_tree=$(cd "$CSDR_SOURCE_ROOT" && \
    while IFS= read -r rel; do
        printf '%s:%s\n' "$rel" "$(sha256sum "$rel" | awk '{print $1}')"
    done < <(find src -type f -name '*.jl' -print | LC_ALL=C sort) | sha256sum | awk '{print $1}')
[[ "$actual_csdr_tree" == "$CSDR_SOURCE_TREE_SHA256" ]] || {
    echo "CSDR source tree differs from the pinned campaign identity" >&2
    exit 3
}

# Syntax and canonical one-point dry-run checks happen on the compute node.
for script in \
    "$SCRIPT_DIR/csdr_campaign_manifest.sh" \
    "$SCRIPT_DIR/csdr_campaign_launch.sh" \
    "$SCRIPT_DIR/csdr_campaign_validate.sh" \
    "$SCRIPT_DIR/csdr_cache_build.pbs" \
    "$SCRIPT_DIR/csdr_cache_solve.pbs" \
    "$SCRIPT_DIR/csdr_campaign_preflight.pbs" \
    "$SCRIPT_DIR/csdr_campaign_controller.pbs" \
    "$SCRIPT_DIR/csdr_campaign_tests.pbs"; do
    bash -n "$script"
done
gate_tmp=$(mktemp -d "${TMPDIR:-/tmp}/csdr-campaign-gate.XXXXXX")
trap 'rm -rf "$gate_tmp"' EXIT
"$MANIFEST_TOOL" --phase solve --stage alpha --output "$gate_tmp/alpha.tsv"
awk -F '\t' 'NR == 1 {next} NR == 2 {ok = ($1 == "solve" && $4 == 40 && $6 == 400 && $8 == 2 && $13 == "small16")} END {exit(ok ? 0 : 1)}' "$gate_tmp/alpha.tsv"

# The controller must also accept a clean validation directory with no
# resource-frontier TSVs.  Exercise the actual PBS wrapper with a shell stub
# for Julia so this regression stays deterministic and does not build or solve
# a model.  This specifically covers the `set -u` empty-array path.
empty_frontier_root="$gate_tmp/controller-empty-frontier"
mkdir -p "$empty_frontier_root/manifests" \
    "$empty_frontier_root/validation/alpha-empty-frontier" \
    "$empty_frontier_root/results"
printf 'phase\tstage\tcase_id\nsolve\talpha\tseed\n' \
    > "$empty_frontier_root/manifests/csdr-grid-solve.tsv"
printf 'failed=0\n' \
    > "$empty_frontier_root/validation/alpha-empty-frontier/campaign_summary.toml"
printf '# controller stub\n' > "$empty_frontier_root/csdr_convergence_cli.jl"
printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'output=' \
    'for ((i = 1; i <= $#; i++)); do' \
    '    if [[ "${!i}" == --output ]]; then' \
    '        ((i++))' \
    '        output="${!i}"' \
    '    elif [[ "${!i}" == --frontier ]]; then' \
    '        echo "unexpected frontier argument" >&2' \
    '        exit 31' \
    '    fi' \
    'done' \
    '[[ -n "$output" ]]' \
    'printf "status=complete\\n" > "$output"' \
    > "$empty_frontier_root/fake-julia"
chmod +x "$empty_frontier_root/fake-julia"
env \
    "CAMPAIGN_ROOT=$empty_frontier_root" \
    "CSDR_SOLVE_MANIFEST=$empty_frontier_root/manifests/csdr-grid-solve.tsv" \
    SDPX_DEPLOYED_COMMIT=0000000000000000000000000000000000000000 \
    MFLA_DEPLOYED_COMMIT=1111111111111111111111111111111111111111 \
    CSDR_SOURCE_TREE_SHA256=2222222222222222222222222222222222222222222222222222222222222222 \
    "CSDR_CONTROLLER=$empty_frontier_root/csdr_convergence_cli.jl" \
    CSDR_STAGE=alpha \
    CSDR_RUN_ID=empty-frontier \
    "JULIA_BIN=$empty_frontier_root/fake-julia" \
    bash "$SCRIPT_DIR/csdr_campaign_controller.pbs" >/dev/null
test -L "$empty_frontier_root/validation/convergence-alpha-latest.toml"

# Exercise the real CLI through the controller wrapper with one synthetic,
# fully certified seed row.  This remains model/solver-free but reaches main's
# manifest parsing, point validation, adaptive action selection, TOML writing,
# and wrapper output checks (including the no-frontier path).
cli_e2e_root="$gate_tmp/controller-cli-e2e"
cli_result_dir="$cli_e2e_root/results/alpha/j40/nmu400/q2"
mkdir -p "$cli_e2e_root/manifests" "$cli_result_dir" \
    "$cli_e2e_root/validation/alpha-cli-e2e"
printf '%s\n' \
    'J = 40' \
    'N_mu = 400' \
    'N_a = 15' \
    'N_x = 1' \
    'alpha_count = 2' \
    'alpha_set = "0,-1/2"' \
    'solve_arithmetic = "Float64x2"' \
    'precompute_precision_bits = 256' \
    'memory_estimate_gate_valid = true' \
    'numerical_gate_valid = true' \
    "sdpx_commit = \"$SDPX_DEPLOYED_COMMIT\"" \
    "mfla_commit = \"$MFLA_DEPLOYED_COMMIT\"" \
    "csdr_source_tree_sha256 = \"$CSDR_SOURCE_TREE_SHA256\"" \
    'driver_sha256 = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"' \
    'cache_sha256 = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"' \
    'status = "Optimal"' \
    'certificate_available = true' \
    'certificate_valid = true' \
    'primal_residual = "1e-7"' \
    'dual_residual = "2e-7"' \
    'relative_gap = "3e-7"' \
    'tolerance_primal = "1e-6"' \
    'tolerance_dual = "1e-6"' \
    'tolerance_relative_gap = "1e-6"' \
    'physical_g0_lower_bound = "1.0"' \
    'physical_g0_upper_bound = "1.0"' \
    'physical_g0_max = "1.0"' \
    'la_planned_provider = "multifloat_linear_algebra"' \
    'planned_la_provider = "multifloat_linear_algebra"' \
    'la_executed_provider = "multifloat_linear_algebra"' \
    'la_fallback_reason = "none"' \
    'fallback_reason = "none"' \
    > "$cli_result_dir/result.toml"
printf 'phase\tstage\tresult_rel\nsolve\talpha\tresults/alpha/j40/nmu400/q2\n' \
    > "$cli_e2e_root/manifests/csdr-grid-solve.tsv"
printf 'failed=0\n' \
    > "$cli_e2e_root/validation/alpha-cli-e2e/campaign_summary.toml"
env \
    "CAMPAIGN_ROOT=$cli_e2e_root" \
    "CSDR_SOLVE_MANIFEST=$cli_e2e_root/manifests/csdr-grid-solve.tsv" \
    "SDPX_DEPLOYED_COMMIT=$SDPX_DEPLOYED_COMMIT" \
    "MFLA_DEPLOYED_COMMIT=$MFLA_DEPLOYED_COMMIT" \
    "CSDR_SOURCE_TREE_SHA256=$CSDR_SOURCE_TREE_SHA256" \
    "CSDR_CONTROLLER=$CONVERGENCE_CLI" \
    CSDR_STAGE=alpha \
    CSDR_RUN_ID=cli-e2e \
    "JULIA_BIN=$JULIA_BIN" \
    CSDR_DRIVER= \
    CSDR_DRIVER_SHA256= \
    CSDR_CONTROLLER_OUTPUT= \
    bash "$SCRIPT_DIR/csdr_campaign_controller.pbs" >/dev/null
cli_output="$cli_e2e_root/validation/convergence-alpha-latest.toml"
test -s "$cli_output"
grep -Eq '^status[[:space:]]*=[[:space:]]*"pending"$' "$cli_output"
grep -Eq '^valid_row_count[[:space:]]*=[[:space:]]*1$' "$cli_output"
grep -Eq '^action[[:space:]]*=[[:space:]]*"run"$' "$cli_output"

# Release/driver parser gates.  Invalid-grid must fail closed; no model solve
# is launched by this job.
"$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" "$DRIVER" --help >/dev/null
"$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    "$CONVERGENCE_CLI" --help >/dev/null
if "$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" "$DRIVER" \
    --mode=preflight-cache --cache="$gate_tmp/missing.cache" --output="$gate_tmp/out.toml" \
    --J=39 --N_x=1 --n-mu=400 --n-a=15 --alpha-level=1 \
    --precompute-bits=256 --node-memory-gb=176 --maximum-iterations=1 \
    --maximum-time=60 --solver-threads=16 >/dev/null 2>&1; then
    echo 'driver accepted an invalid-grid gate invocation' >&2
    exit 1
fi
"$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    -e 'using MultiFloatLinearAlgebra; print(pathof(MultiFloatLinearAlgebra))' >/dev/null
"$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" "$CONVERGENCE_TEST"

if [[ "${SDPX_RUN_CSDR_CAMPAIGN_TESTS:-0}" == 1 ]]; then
    test -f "$CACHE_TEST"
    SDPX_RUN_CSDR_CACHE_CONTRACT_TESTS=1 \
        "$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" "$CACHE_TEST"
fi
echo 'csdr campaign cluster gate: PASS'
