#!/usr/bin/env bash
# Solve one immutable CSDR cache row.
#
# The default request is large64. The launcher overrides PBS resources for the
# small16 array, while this script validates the actual allocation before the
# Julia process starts.
#PBS -N csdr-cache-solve
#PBS -q normal
#PBS -l nodes=1:ppn=64
#PBS -l mem=224gb
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail

: "${CAMPAIGN_ROOT:?qsub must export CAMPAIGN_ROOT}"
: "${SDPX_SOURCE_ROOT:?qsub must export SDPX_SOURCE_ROOT}"
: "${SDPX_ENV_ROOT:?qsub must export SDPX_ENV_ROOT}"
readonly CSDR_SOURCE_ROOT="${CSDR_SOURCE_ROOT:-$CAMPAIGN_ROOT/csdr-source}"

readonly MANIFEST="${CSDR_SOLVE_MANIFEST:-}"
readonly ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}"

if [[ -n "$MANIFEST" ]]; then
    : "${ARRAY_INDEX:?array solve requires PBS_ARRAY_INDEX/PBS_ARRAYID}"
    row=$(sed -n "$((ARRAY_INDEX + 2))p" "$MANIFEST")
    [[ -n "$row" ]] || { echo "missing solve manifest row $ARRAY_INDEX" >&2; exit 2; }
    IFS=$'\t' read -r phase stage case_id j na nmu alpha_level alpha_count frontier_max_count \
        predicted_peak_gib nred solver_threads resource_class requested_cores memory_gb walltime \
        cache_alpha_level cache_alpha_count cache_rel result_rel build_rel predecessor_key <<< "$row"
    [[ "$phase" == solve ]] || { echo "manifest row is not a solve row: $phase" >&2; exit 2; }
    export CSDR_J="$j" CSDR_N_A="$na" CSDR_N_MU="$nmu"
    export CSDR_ALPHA_LEVEL="$alpha_level" CSDR_ALPHA_COUNT="$alpha_count"
    export CSDR_CACHE_ALPHA_LEVEL="$cache_alpha_level" CSDR_CACHE_ALPHA_COUNT="$cache_alpha_count"
    export SDPX_SOLVER_THREADS="$solver_threads" CSDR_RESOURCE_CLASS="$resource_class"
    export CSDR_CACHE_REL="$cache_rel" CSDR_RESULT_REL="$result_rel"
    export CSDR_CASE_ID="$case_id" CSDR_BUILD_REL="$build_rel"
else
    : "${CSDR_J:?set CSDR_J or CSDR_SOLVE_MANIFEST}"
    : "${CSDR_N_MU:?set CSDR_N_MU or CSDR_SOLVE_MANIFEST}"
    CSDR_N_A="${CSDR_N_A:-$((3 * CSDR_J / 8))}"
    CSDR_ALPHA_LEVEL="${CSDR_ALPHA_LEVEL:-1}"
    CSDR_ALPHA_COUNT="${CSDR_ALPHA_COUNT:-$(( (1 << (CSDR_ALPHA_LEVEL - 1)) + 1 ))}"
    SDPX_SOLVER_THREADS="${SDPX_SOLVER_THREADS:-16}"
    CSDR_RESOURCE_CLASS="${CSDR_RESOURCE_CLASS:-large64}"
    case "${CSDR_J}:${CSDR_N_MU}" in
        40:400|40:800|40:1600|40:3200|80:400|80:800|80:1600|160:400) cache_alpha_count=33 ;;
        80:3200|160:800) cache_alpha_count=17 ;;
        160:1600|320:400) cache_alpha_count=9 ;;
        160:3200|320:800) cache_alpha_count=5 ;;
        320:1600) cache_alpha_count=3 ;;
        320:3200) cache_alpha_count=2 ;;
        *) echo "unsupported cache frontier" >&2; exit 2 ;;
    esac
    CSDR_CACHE_REL="${CSDR_CACHE_REL:-cache/j${CSDR_J}/nmu${CSDR_N_MU}/alpha${cache_alpha_count}.bin}"
    CSDR_CACHE_ALPHA_COUNT="${CSDR_CACHE_ALPHA_COUNT:-$cache_alpha_count}"
    case "$CSDR_CACHE_ALPHA_COUNT" in 2) CSDR_CACHE_ALPHA_LEVEL=1 ;; 3) CSDR_CACHE_ALPHA_LEVEL=2 ;; 5) CSDR_CACHE_ALPHA_LEVEL=3 ;; 9) CSDR_CACHE_ALPHA_LEVEL=4 ;; 17) CSDR_CACHE_ALPHA_LEVEL=5 ;; 33) CSDR_CACHE_ALPHA_LEVEL=6 ;; *) exit 2 ;; esac
    CSDR_RESULT_REL="${CSDR_RESULT_REL:-results/j${CSDR_J}/nmu${CSDR_N_MU}/alpha${CSDR_ALPHA_COUNT}/t${SDPX_SOLVER_THREADS}}"
    CSDR_CASE_ID="${CSDR_CASE_ID:-j${CSDR_J}-nmu${CSDR_N_MU}-alpha${CSDR_ALPHA_COUNT}-t${SDPX_SOLVER_THREADS}}"
    CSDR_BUILD_REL="${CSDR_BUILD_REL:-build/j${CSDR_J}/nmu${CSDR_N_MU}/alpha${cache_alpha_count}}"
fi

stage="${stage:-${CSDR_STAGE:-alpha}}"
case "$CSDR_J" in 40|80|160|320) ;; *) echo "unsupported J: $CSDR_J" >&2; exit 2 ;; esac
case "$CSDR_N_MU" in 400|800|1600|3200) ;; *) echo "unsupported N_mu: $CSDR_N_MU" >&2; exit 2 ;; esac
case "$CSDR_ALPHA_LEVEL" in 1|2|3|4|5|6) ;; *) echo "unsupported alpha level: $CSDR_ALPHA_LEVEL" >&2; exit 2 ;; esac
case "$SDPX_SOLVER_THREADS" in 16|64) ;; *) echo "production solver threads must be 16 or 64" >&2; exit 2 ;; esac
((CSDR_N_A == 3 * CSDR_J / 8)) || { echo "N_a must equal 3*J/8" >&2; exit 2; }
expected_alpha=$(( (1 << (CSDR_ALPHA_LEVEL - 1)) + 1 ))
((CSDR_ALPHA_COUNT == expected_alpha)) || { echo "alpha count does not match level" >&2; exit 2; }
case "$CSDR_CACHE_ALPHA_LEVEL" in 1|2|3|4|5|6) ;; *) echo "unsupported cache alpha level" >&2; exit 2 ;; esac
expected_cache_alpha=$(( (1 << (CSDR_CACHE_ALPHA_LEVEL - 1)) + 1 ))
((CSDR_CACHE_ALPHA_COUNT == expected_cache_alpha)) || { echo "cache alpha count does not match level" >&2; exit 2; }
((CSDR_ALPHA_COUNT <= CSDR_CACHE_ALPHA_COUNT)) || { echo "requested alpha exceeds cache maximum" >&2; exit 2; }

case "$CSDR_RESOURCE_CLASS" in
    small16) expected_slots=16; expected_memory=96; expected_wall=04:00:00; maximum_time=12600 ;;
    medium64) expected_slots=64; expected_memory=160; expected_wall=12:00:00; maximum_time=39600 ;;
    high64|large64) expected_slots=64; expected_memory=224; expected_wall=48:00:00; maximum_time=165600 ;;
    *) echo "unsupported resource class: $CSDR_RESOURCE_CLASS" >&2; exit 2 ;;
esac
if [[ "$CSDR_RESOURCE_CLASS" == small16 && "$SDPX_SOLVER_THREADS" != 16 ]] ||
   [[ "$CSDR_RESOURCE_CLASS" != small16 && "$SDPX_SOLVER_THREADS" != 64 ]]; then
    echo "resource class $CSDR_RESOURCE_CLASS requires matching production thread width" >&2
    exit 2
fi

allocated_slots=$(wc -l < "${PBS_NODEFILE:-/dev/null}" 2>/dev/null || echo 0)
(( allocated_slots >= expected_slots )) || {
    echo "resource class $CSDR_RESOURCE_CLASS requires $expected_slots slots (got $allocated_slots)" >&2
    exit 2
}
(( allocated_slots <= 768 )) || { echo "allocation exceeds campaign cap" >&2; exit 2; }

readonly SHARED_ROOT="${CSDR_SHARED_ROOT:-/public/home/yongjunxu/projects/csdr-clarabel-multifloat}"
readonly JULIA_BIN="${JULIA_BIN:-$SHARED_ROOT/julia/julia-1.12.6/bin/julia}"
readonly DRIVER="${CSDR_DRIVER:-$CAMPAIGN_ROOT/driver/g0_max_bigfloat256_float64x2.jl}"
readonly CACHE="$CAMPAIGN_ROOT/$CSDR_CACHE_REL"
readonly RESULT_ROOT="$CAMPAIGN_ROOT/$CSDR_RESULT_REL"
readonly BUILD_ROOT="$CAMPAIGN_ROOT/$CSDR_BUILD_REL"
readonly PREFLIGHT="$CAMPAIGN_ROOT/preflight/$stage/j${CSDR_J}/nmu${CSDR_N_MU}/q${CSDR_ALPHA_COUNT}/preflight.toml"
readonly N_X="${CSDR_N_X:-1}"
readonly NODE_MEMORY_GB="${CSDR_NODE_MEMORY_GB:-176}"

test -x "$JULIA_BIN"
test -f "$DRIVER"
test -f "$BUILD_ROOT/cache.sha256"
test -f "$BUILD_ROOT/source.sha256"
test -f "$SDPX_SOURCE_ROOT/Project.toml"
test -d "$SDPX_SOURCE_ROOT/ext"
test -f "$SDPX_ENV_ROOT/Project.toml"
test -f "$SDPX_ENV_ROOT/Manifest.toml"
test -f "$CSDR_SOURCE_ROOT/src/csdr_model.jl"

mkdir -p "$RESULT_ROOT/attempts"
if [[ -e "$RESULT_ROOT/result.toml" || -e "$RESULT_ROOT/SOLVE_COMPLETE" || -e "$RESULT_ROOT/resource_frontier.toml" ]]; then
    echo "refusing to overwrite immutable result: $RESULT_ROOT" >&2
    exit 3
fi

readonly ATTEMPT_ROOT="$RESULT_ROOT/attempts/${PBS_JOBID:-manual}"
readonly RESULT_TMP="$ATTEMPT_ROOT/result.toml"
mkdir -p "$ATTEMPT_ROOT"

export JULIA_NUM_THREADS="$SDPX_SOLVER_THREADS"
export JULIA_DEPOT_PATH="${JULIA_DEPOT_PATH:-$SHARED_ROOT/depot}"
export JULIA_PROJECT="$SDPX_ENV_ROOT"
export JULIA_LOAD_PATH="$SDPX_ENV_ROOT:@stdlib"
export JULIA_PKG_OFFLINE=true
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export CSDR_SOURCE_ROOT
export SDPX_SOURCE_ROOT
: "${MFLA_DEPLOYED_COMMIT:?MFLA_DEPLOYED_COMMIT must come from immutable release metadata}"
[[ "$MFLA_DEPLOYED_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || {
    echo "MFLA_DEPLOYED_COMMIT must be a validated 40-hex commit" >&2
    exit 3
}

source /public/software/profile.d/compiler_gcc_11.sh

deployed_commit="${SDPX_DEPLOYED_COMMIT:-}"
if [[ -z "$deployed_commit" && -f "$CAMPAIGN_ROOT/DEPLOYED_GIT_HEAD" ]]; then
    deployed_commit=$(tr -d '[:space:]' < "$CAMPAIGN_ROOT/DEPLOYED_GIT_HEAD")
fi
[[ "$deployed_commit" =~ ^[0-9a-fA-F]{40}$ ]] || {
    echo "SDPX_DEPLOYED_COMMIT must be a validated 40-hex release commit" >&2
    exit 3
}
if sdpx_head=$(git -C "$SDPX_SOURCE_ROOT" rev-parse HEAD 2>/dev/null); then
    [[ -z "$(git -C "$SDPX_SOURCE_ROOT" status --porcelain --untracked-files=all)" ]] || {
        echo "refusing dirty SDPX_SOURCE_ROOT" >&2
        exit 3
    }
    [[ "$deployed_commit" == "$sdpx_head" ]] || {
        echo "SDPX_DEPLOYED_COMMIT does not match SDPX_SOURCE_ROOT HEAD" >&2
        exit 3
    }
    sdpx_commit="$sdpx_head"
else
    sdpx_commit="$deployed_commit"
fi
if [[ -n "${CSDR_EXPECTED_SDPX_COMMIT:-}" ]]; then
    [[ "$sdpx_commit" == "$CSDR_EXPECTED_SDPX_COMMIT" ]] || {
        echo "SDPX commit $sdpx_commit != expected $CSDR_EXPECTED_SDPX_COMMIT" >&2
        exit 3
    }
fi
sdpx_source_tree_sha256=$(cd "$SDPX_SOURCE_ROOT" && \
    while IFS= read -r rel; do
        printf '%s:' "$rel"
        sha256sum "$rel" | awk '{print $1}'
        printf '\n'
    done < <({ find src ext -type f -name '*.jl' -print; printf '%s\n' Project.toml; } | LC_ALL=C sort -u) | sha256sum | awk '{print $1}')
[[ "$sdpx_source_tree_sha256" =~ ^[0-9a-fA-F]{64}$ ]] || exit 3
csdr_tree_sha256=$(cd "$CSDR_SOURCE_ROOT" && \
    while IFS= read -r rel; do
        printf '%s:' "$rel"
        sha256sum "$rel" | awk '{print $1}'
        printf '\n'
    done < <(find src -type f -name '*.jl' -print | LC_ALL=C sort) | sha256sum | awk '{print $1}')
[[ "$csdr_tree_sha256" =~ ^[0-9a-fA-F]{64}$ ]] || {
    echo "CSDR source tree hash is not 64-hex" >&2
    exit 3
}
if [[ -n "${CSDR_SOURCE_TREE_SHA256:-}" &&
      "${CSDR_SOURCE_TREE_SHA256}" != "$csdr_tree_sha256" ]]; then
    echo "CSDR_SOURCE_TREE_SHA256 does not match CSDR_SOURCE_ROOT" >&2
    exit 3
fi
CSDR_SOURCE_TREE_SHA256="$csdr_tree_sha256"
export SDPX_DEPLOYED_COMMIT="$deployed_commit" MFLA_DEPLOYED_COMMIT
export CSDR_SOURCE_TREE_SHA256
active_project=$("$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    -e 'print(Base.active_project())')
[[ "$active_project" == "$SDPX_ENV_ROOT/Project.toml" ]] || {
    echo "active Julia project does not match SDPX_ENV_ROOT: $active_project" >&2
    exit 3
}
active_sdpx=$("$JULIA_BIN" --startup-file=no --project="$SDPX_ENV_ROOT" \
    -e 'using SDPX; print(pathof(SDPX))')
case "$active_sdpx" in
    "$SDPX_SOURCE_ROOT"/*) ;;
    *) echo "active SDPX package path does not match SDPX_SOURCE_ROOT: $active_sdpx" >&2; exit 3 ;;
esac

expected_cache_hash=$(awk 'NR == 1 {print $1}' "$BUILD_ROOT/cache.sha256")
actual_cache_hash=$(sha256sum "$CACHE" | awk '{print $1}')
[[ -n "$expected_cache_hash" && "$actual_cache_hash" == "$expected_cache_hash" ]] || {
    echo "cache hash mismatch: expected $expected_cache_hash actual $actual_cache_hash" >&2
    exit 3
}

preflight_value() {
    local key=$1
    sed -n -E "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\"?([^\"[:space:]]+)\"?.*$/\1/p" "$PREFLIGHT" | tail -n1
}
require_preflight_value() {
    local expected=$1 key=$2 actual
    actual=$(preflight_value "$key")
    [[ -n "$actual" && "$actual" == "$expected" ]] || {
        echo "preflight gate mismatch for $key: expected=$expected actual=${actual:-<missing>}" >&2
        exit 3
    }
}
[[ -s "$PREFLIGHT" ]] || {
    echo "missing successful preflight artifact: $PREFLIGHT" >&2
    exit 3
}
require_preflight_value passed status
require_preflight_value true preflight_gate_valid
require_preflight_value "$CSDR_J" J
require_preflight_value "$CSDR_N_A" N_a
require_preflight_value "$CSDR_N_MU" N_mu
require_preflight_value "$CSDR_ALPHA_COUNT" requested_alpha_count
require_preflight_value "$CSDR_CACHE_ALPHA_LEVEL" cache_alpha_level
require_preflight_value "$CSDR_CACHE_ALPHA_COUNT" cache_alpha_count
require_preflight_value "$actual_cache_hash" cache_sha256
require_preflight_value "$sdpx_commit" sdpx_commit
require_preflight_value "$MFLA_DEPLOYED_COMMIT" mfla_commit
require_preflight_value "$csdr_tree_sha256" csdr_source_tree_sha256
require_preflight_value multifloat_linear_algebra la_planned_provider
require_preflight_value multifloat_linear_algebra la_executed_provider
require_preflight_value none fallback_reason
require_preflight_value none la_fallback_reason
readonly DRIVER_SHA256=$(sha256sum "$DRIVER" | awk '{print $1}')

{
    sha256sum "$DRIVER" "$SDPX_SOURCE_ROOT/Project.toml" \
        "$SDPX_ENV_ROOT/Project.toml" "$SDPX_ENV_ROOT/Manifest.toml"
    while IFS= read -r rel; do
        (cd "$SDPX_SOURCE_ROOT" && sha256sum "$rel")
    done < <(cd "$SDPX_SOURCE_ROOT" && find src ext -type f -name '*.jl' -print | LC_ALL=C sort)
    while IFS= read -r rel; do
        (cd "$CSDR_SOURCE_ROOT" && sha256sum "$rel")
    done < <(cd "$CSDR_SOURCE_ROOT" && find src -type f -name '*.jl' -print | LC_ALL=C sort)
} > "$ATTEMPT_ROOT/source.sha256"
cmp -s "$BUILD_ROOT/source.sha256" "$ATTEMPT_ROOT/source.sha256" || {
    echo "source/environment fingerprint differs from cache build" >&2
    exit 3
}

if [[ ! -f "$CACHE" || ! -f "$BUILD_ROOT/BUILD_COMPLETE" ]]; then
    if [[ -s "$BUILD_ROOT/resource_frontier.toml" ]]; then
        frontier_result="$RESULT_ROOT/result.toml.part.${PBS_JOBID:-$$}"
        if [[ ! -e "$RESULT_ROOT/result.toml" ]]; then
            {
                echo 'status="RESOURCE_FRONTIER"'
                echo 'solver_status="RESOURCE_FRONTIER"'
                echo "l_max=$CSDR_J"
                echo "N_a=$CSDR_N_A"
                echo "N_mu=$CSDR_N_MU"
                echo "N_x=$N_X"
                echo "alpha_level=$CSDR_ALPHA_LEVEL"
                echo "alpha_count=$CSDR_ALPHA_COUNT"
                echo 'solve_arithmetic="Float64x2"'
                echo 'precompute_precision_bits=256'
                echo 'memory_estimate_gate_valid=false'
                echo 'cache_digest_gate_valid=false'
                echo 'certificate_valid=false'
                echo 'numerical_gate_valid=false'
                echo 'la_planned_provider="multifloat_linear_algebra"'
                echo 'la_executed_provider="multifloat_linear_algebra"'
                echo 'fallback_reason="none"'
                echo 'la_fallback_reason="none"'
                echo 'orchestration_owner="SDPX"'
                echo "sdpx_commit=\"$sdpx_commit\""
                echo "mfla_commit=\"$MFLA_DEPLOYED_COMMIT\""
                echo "driver_sha256=\"$DRIVER_SHA256\""
                echo "csdr_source_tree_sha256=\"$csdr_tree_sha256\""
                echo 'cache_sha256=""'
                echo 'resource_frontier="unresolved_at_resource_frontier"'
                echo "frontier_evidence=\"$BUILD_ROOT/resource_frontier.toml\""
            } > "$frontier_result"
            mv "$frontier_result" "$RESULT_ROOT/result.toml"
            touch "$RESULT_ROOT/SOLVE_COMPLETE"
        fi
        exit 1
    fi
fi
test -f "$CACHE"
test -f "$BUILD_ROOT/BUILD_COMPLETE"

provenance="$ATTEMPT_ROOT/provenance.txt"
{
    echo "phase=solve-cache"
    echo "case_id=$CSDR_CASE_ID"
    echo "pbs_jobid=${PBS_JOBID:-manual}"
    echo "hostname=$(hostname)"
    echo "allocated_slots=$allocated_slots"
    echo "resource_class=$CSDR_RESOURCE_CLASS"
    echo "orchestration_owner=SDPX"
    echo "requested_memory_gb=$expected_memory"
    echo "requested_walltime=$expected_wall"
    echo "solver_threads=$SDPX_SOLVER_THREADS"
    echo "julia_threads=$JULIA_NUM_THREADS"
    echo "J=$CSDR_J"
    echo "N_a=$CSDR_N_A"
    echo "N_mu=$CSDR_N_MU"
    echo "alpha_level=$CSDR_ALPHA_LEVEL"
    echo "alpha_count=$CSDR_ALPHA_COUNT"
    echo "cache_alpha_level=$CSDR_CACHE_ALPHA_LEVEL"
    echo "cache_alpha_count=$CSDR_CACHE_ALPHA_COUNT"
    echo "sdpx_source_root=$SDPX_SOURCE_ROOT"
    echo "sdpx_env_root=$SDPX_ENV_ROOT"
    echo "sdpx_commit=$sdpx_commit"
    echo "sdpx_source_tree_sha256=$sdpx_source_tree_sha256"
    echo "sdpx_deployed_commit=$deployed_commit"
    echo "mfla_commit=$MFLA_DEPLOYED_COMMIT"
    echo "csdr_source_tree_sha256=$csdr_tree_sha256"
    echo "driver_sha256=$DRIVER_SHA256"
    echo "la_planned_provider=multifloat_linear_algebra"
    echo "la_executed_provider=multifloat_linear_algebra"
    echo "fallback_reason=none"
    echo "la_fallback_reason=none"
    echo "active_project=$active_project"
    echo "active_sdpx=$active_sdpx"
    echo "cache_sha256=$actual_cache_hash"
    echo "source_hash_file=$RESULT_ROOT/source.sha256"
    echo "started_utc=$(date -u +%FT%TZ)"
} > "$provenance"

sha256sum "$CACHE" "$DRIVER" "$SDPX_SOURCE_ROOT/Project.toml" \
    "$SDPX_ENV_ROOT/Manifest.toml" > "$ATTEMPT_ROOT/input.sha256"

command=(
    "$JULIA_BIN"
    --startup-file=no
    --project="$SDPX_ENV_ROOT"
    "$DRIVER"
    --mode=solve-cache
    --cache="$CACHE"
    --output="$RESULT_TMP"
    --J="$CSDR_J"
    --N_x="$N_X"
    --n-mu="$CSDR_N_MU"
    --n-a="$CSDR_N_A"
    --alpha-level="$CSDR_ALPHA_LEVEL"
    --precompute-bits=256
    --node-memory-gb="$NODE_MEMORY_GB"
    --tolerance=1e-6
    --maximum-iterations=250
    --maximum-time="$maximum_time"
    --solver-threads="$SDPX_SOLVER_THREADS"
    --warmup-iterations=2
    --verbosity=0
)

if command -v numactl >/dev/null 2>&1; then
    if ! /usr/bin/time -v -o "$ATTEMPT_ROOT/time.txt" numactl --interleave=all "${command[@]}" \
        > "$ATTEMPT_ROOT/stdout" 2> "$ATTEMPT_ROOT/stderr"; then
        if grep -Eqi 'frontier|memory|node-memory|exceeds' "$ATTEMPT_ROOT/stderr"; then
            frontier_tmp="$RESULT_ROOT/resource_frontier.toml.part.${PBS_JOBID:-$$}"
            {
                echo 'status="unresolved_at_resource_frontier"'
                echo "case_id=$CSDR_CASE_ID"
                echo "J=$CSDR_J"
                echo "N_mu=$CSDR_N_MU"
                echo "alpha_level=$CSDR_ALPHA_LEVEL"
                echo "alpha_count=$CSDR_ALPHA_COUNT"
                echo "resource_class=$CSDR_RESOURCE_CLASS"
                echo "requested_memory_gb=$expected_memory"
                echo "frontier_evidence=$ATTEMPT_ROOT/stderr"
                echo "sdpx_commit=$sdpx_commit"
                echo "mfla_commit=$MFLA_DEPLOYED_COMMIT"
                echo "csdr_source_tree_sha256=$csdr_tree_sha256"
                echo "recorded_utc=$(date -u +%FT%TZ)"
            } > "$frontier_tmp"
            mv "$frontier_tmp" "$RESULT_ROOT/resource_frontier.toml"
        fi
        exit 1
    fi
else
    if ! /usr/bin/time -v -o "$ATTEMPT_ROOT/time.txt" "${command[@]}" > "$ATTEMPT_ROOT/stdout" 2> "$ATTEMPT_ROOT/stderr"; then
        if grep -Eqi 'frontier|memory|node-memory|exceeds' "$ATTEMPT_ROOT/stderr"; then
            frontier_tmp="$RESULT_ROOT/resource_frontier.toml.part.${PBS_JOBID:-$$}"
            {
                echo 'status="unresolved_at_resource_frontier"'
                echo "case_id=$CSDR_CASE_ID"
                echo "J=$CSDR_J"
                echo "N_mu=$CSDR_N_MU"
                echo "alpha_level=$CSDR_ALPHA_LEVEL"
                echo "alpha_count=$CSDR_ALPHA_COUNT"
                echo "resource_class=$CSDR_RESOURCE_CLASS"
                echo "requested_memory_gb=$expected_memory"
                echo "frontier_evidence=$ATTEMPT_ROOT/stderr"
                echo "sdpx_commit=$sdpx_commit"
                echo "mfla_commit=$MFLA_DEPLOYED_COMMIT"
                echo "csdr_source_tree_sha256=$csdr_tree_sha256"
                echo "recorded_utc=$(date -u +%FT%TZ)"
            } > "$frontier_tmp"
            mv "$frontier_tmp" "$RESULT_ROOT/resource_frontier.toml"
        fi
        exit 1
    fi
fi

test -s "$RESULT_TMP"
rss_kib=$(awk -F: '/Maximum resident set size/ {gsub(/[^0-9]/,"",$2); print $2}' "$ATTEMPT_ROOT/time.txt" | tail -n1)
peak_rss_bytes=$(( ${rss_kib:-0} * 1024 ))
driver_peak_rss_bytes=$(sed -n -E 's/^[[:space:]]*peak_rss_bytes[[:space:]]*=[[:space:]]*"?([0-9]+)"?.*$/\1/p' "$RESULT_TMP" | tail -n1)
[[ "$driver_peak_rss_bytes" =~ ^[0-9]+$ ]] || driver_peak_rss_bytes=0
((peak_rss_bytes <= 176 * 1024 * 1024 * 1024)) || {
    frontier_tmp="$RESULT_ROOT/resource_frontier.toml.part.${PBS_JOBID:-$$}"
    { echo 'status="unresolved_at_resource_frontier"'; echo "peak_rss_bytes=$peak_rss_bytes"; echo 'memory_cap_gb=176'; } > "$frontier_tmp"
    mv "$frontier_tmp" "$RESULT_ROOT/resource_frontier.toml"
    exit 1
}

ensure_result_value() {
    local key=$1 expected=$2 actual
    if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$RESULT_TMP"; then
        actual=$(sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"?([^\"[:space:]]+)\"?.*$/\1/p" "$RESULT_TMP" | tail -n 1)
        [[ "$actual" == "$expected" ]] || {
            echo "result metadata mismatch for $key: expected $expected actual ${actual:-<missing>}" >&2
            exit 3
        }
    else
        printf '%s="%s"\n' "$key" "$expected" >> "$RESULT_TMP"
    fi
}

ensure_result_value orchestration_owner SDPX
ensure_result_value pbs_jobid "${PBS_JOBID:-manual}"
ensure_result_value hostname "$(hostname)"
ensure_result_value allocated_slots "$allocated_slots"
ensure_result_value resource_class "$CSDR_RESOURCE_CLASS"
ensure_result_value requested_memory_gb "$expected_memory"
ensure_result_value requested_walltime "$expected_wall"
ensure_result_value la_planned_provider multifloat_linear_algebra
ensure_result_value la_executed_provider multifloat_linear_algebra
ensure_result_value fallback_reason none
ensure_result_value la_fallback_reason none
ensure_result_value sdpx_commit "$sdpx_commit"
ensure_result_value sdpx_source_tree_sha256 "$sdpx_source_tree_sha256"
ensure_result_value mfla_commit "$MFLA_DEPLOYED_COMMIT"
ensure_result_value driver_sha256 "$DRIVER_SHA256"
ensure_result_value csdr_source_tree_sha256 "$csdr_tree_sha256"
ensure_result_value cache_sha256 "$actual_cache_hash"
ensure_result_value process_peak_rss_bytes "$peak_rss_bytes"
echo "finished_utc=$(date -u +%FT%TZ)" >> "$provenance"
echo "completed=true" >> "$provenance"

# Promote only after the complete result exists. A retry can never replace a
# completed case; its attempt directory remains available for diagnosis.
mv "$RESULT_TMP" "$RESULT_ROOT/result.toml"
cp "$provenance" "$RESULT_ROOT/provenance.txt"
cp "$ATTEMPT_ROOT/input.sha256" "$RESULT_ROOT/input.sha256"
cp "$ATTEMPT_ROOT/source.sha256" "$RESULT_ROOT/source.sha256"
touch "$RESULT_ROOT/SOLVE_COMPLETE"
