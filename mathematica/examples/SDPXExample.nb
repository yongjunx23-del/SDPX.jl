Notebook[{

Cell[TextData[{"SDPX from Mathematica \[LongDash] the command-line bridge"}], "Title"],

Cell[TextData[{
"One-time setup from the SDPX.jl repository root:  ",
StyleBox["julia --project=bin -e 'using Pkg; Pkg.develop(path=\".\"); Pkg.instantiate()'", "Program"],
".  Then load the package (adjust the path to your checkout)."
}], "Text"],

Cell[BoxData[
 RowBox[{"<<", " ", "\"\<~/Desktop/project/SDPX/SDPX.jl/mathematica/SDPXLink.wl\>\""}]], "Input"],

Cell[TextData[{
"The problem: minimise 2x\[ThinSpace]\[Subscript[x, 1]] + 3\[ThinSpace]\[Subscript[x, 2]] subject to {{\[Subscript[x, 1]], -1}, {-1, \[Subscript[x, 2]]}} \[SucceedsEqual] 0.  ",
"The constraint is \[Subscript[x, 1]]\[Subscript[x, 2]] \[GreaterEqual] 1, so the exact optimum is 2\[Sqrt]6."
}], "Text"],

Cell[BoxData[{
 RowBox[{"c", "=", RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "\[IndentingNewLine]",
 RowBox[{"A", "=", RowBox[{"{", RowBox[{"{", RowBox[{
     RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",",
     RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "}"}], "}"}]}], "\[IndentingNewLine]",
 RowBox[{"Cmat", "=", RowBox[{"{", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "}"}]}]}], "Input"],

Cell[BoxData[
 RowBox[{"result", "=", RowBox[{"SDPXOptimize", "[", RowBox[{"c", ",", "A", ",", "Cmat"}], "]"}]}], "Input"],

Cell[BoxData[{
 RowBox[{"result", "[", "\"\<Objective\>\"", "]"}], "\[IndentingNewLine]",
 RowBox[{RowBox[{"result", "[", "\"\<Objective\>\"", "]"}], "-", RowBox[{"2", RowBox[{"Sqrt", "[", "6.", "]"}]}]}], "\[IndentingNewLine]",
 RowBox[{"result", "[", "\"\<x\>\"", "]"}], "\[IndentingNewLine]",
 RowBox[{"result", "[", "\"\<Certificate\>\"", "]"}]}], "Input"],

Cell[TextData[{
"High precision: request BigFloat and a 1e-30 tolerance. Numbers cross the \
bridge as strings, so the ~30 digits survive the round trip \[LongDash] \
compare against the exact 2\[Sqrt]6."
}], "Text"],

Cell[BoxData[
 RowBox[{"big", "=", RowBox[{"SDPXOptimize", "[", RowBox[{"c", ",", "A", ",", "Cmat", ",",
    RowBox[{"\"\<Precision\>\"", "->", "\"\<BigFloat\>\""}], ",",
    RowBox[{"\"\<PrecisionBits\>\"", "->", "256"}], ",",
    RowBox[{"\"\<Tolerance\>\"", "->", "\"\<1e-30\>\""}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"-", RowBox[{"Log10", "[", RowBox[{"Abs", "[", RowBox[{RowBox[{"big", "[", "\"\<Objective\>\"", "]"}], "-", RowBox[{"2", RowBox[{"Sqrt", "[", RowBox[{"N", "[", RowBox[{"6", ",", "60"}], "]"}], "]"}]}]}], "]"}], "]"}]}]], "Input"],

Cell[TextData[{
"Failures are structured: a bad problem or a missing Julia returns a ",
StyleBox["Failure", "Program"],
" object carrying the solver's own message, never a raw stack trace. A solve \
that merely hits its iteration limit is a result with ",
StyleBox["\"Optimal\" -> False", "Program"],
", not a Failure."
}], "Text"],

Cell[BoxData[
 RowBox[{"SDPXOptimize", "[", RowBox[{"c", ",", "A", ",", "Cmat", ",", RowBox[{"\"\<MaxIterations\>\"", "->", "1"}]}], "]"}]], "Input"]

}, WindowSize -> {900, 700}, StyleDefinitions -> "Default.nb"]
