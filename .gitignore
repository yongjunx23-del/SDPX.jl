# Julia environment resolution — a package must not pin its dependents.
Manifest.toml
**/Manifest.toml

# Documentation build output
docs/build/
docs/site/

# Coverage and profiling artefacts
*.jl.cov
*.jl.*.cov
*.jl.mem
coverage/
lcov.info
*.prof
*.trace
flamegraph*.svg

# Benchmark inputs and outputs. These are regenerated by the scripts in bench/
# and are far too large to distribute — the serialized problem instances alone
# run to gigabytes.
bench/**/results/
bench/**/out/
bench/**/*.bin
bench/**/*.log
bench/**/*.out
bench/**/*.err
bench/**/*.csv
bench/**/*.json
bench/**/*.jld2
bench/**/*.npy
bench/**/*.npz
bench/**/__pycache__/

# Machine-specific scheduler scripts. These embed absolute paths, usernames and
# site-specific module environments; the portable drivers they invoke are the
# reproducible part and are kept.
*.pbs
# The fixed-trace campaign scripts are portable templates: every site-specific
# path is supplied through environment variables, so keep them with the
# reproducible benchmark harness.
!bench/soc_fixed_trace/*.pbs
*.o[0-9]*
*.e[0-9]*

# Local scratch
scratch/
tmp/
*.tmp
core
core.*
LocalPreferences.toml
.julia/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
.pytest_cache/
.coverage
*.swp
*~

# Locally built native artefacts
*.o
*.a
*.so
*.dylib
*.dll
