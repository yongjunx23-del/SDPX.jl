# Julia environment resolution — a package must not pin its dependents.
Manifest.toml
**/Manifest.toml

# Documentation build output
docs/build/
docs/site/
/.ghcache/

# Coverage and profiling artefacts
*.jl.cov
*.jl.*.cov
*.jl.mem
coverage/
lcov.info
*.prof
*.trace
flamegraph*.svg

# Generated benchmark inputs and results can be large.
benchmark/general/data/**
!benchmark/general/data/.gitignore
!benchmark/general/data/MANIFEST.sha256
benchmark/bootstrap/out/
benchmark/out/
/work/

# Machine-specific scheduler scripts. These embed absolute paths, usernames and
# site-specific module environments; the portable drivers they invoke are the
# reproducible part and are kept.
*.pbs
*.o[0-9]*
*.e[0-9]*

# Local scratch and autoresearch session state
.auto/
scratch/
tmp/
*.tmp

core
/core.*
LocalPreferences.toml
.julia/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
.pytest_cache/
.coverage
*.swp
*~

# Locally built native artefacts
*.o
*.a
*.so
*.dylib
*.dll
