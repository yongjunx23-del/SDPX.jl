# Julia environment resolution — a package must not pin its dependents.
Manifest.toml
**/Manifest.toml

# Documentation build output
docs/build/
docs/site/
/.ghcache/

# Coverage and profiling artefacts
*.jl.cov
*.jl.*.cov
*.jl.mem
coverage/
lcov.info
*.prof
*.trace
flamegraph*.svg

# Benchmark inputs and outputs regenerated by the retained evidence drivers.
# Serialized problem instances can run to gigabytes.
docs/evidence/bench/**/results/
docs/evidence/bench/**/out/
docs/evidence/bench/**/*.bin
docs/evidence/bench/**/*.log
docs/evidence/bench/**/*.out
docs/evidence/bench/**/*.err
docs/evidence/bench/**/*.csv
docs/evidence/bench/**/*.json
docs/evidence/bench/**/*.jld2
docs/evidence/bench/**/*.npy
docs/evidence/bench/**/*.npz
docs/evidence/bench/**/__pycache__/
docs/evidence/bench/bootstrap/full_unitarity_eft/gram_ab_t*.toml
benchmark/data/cache/
benchmark/out/
/work/

# Machine-specific scheduler scripts. These embed absolute paths, usernames and
# site-specific module environments; the portable drivers they invoke are the
# reproducible part and are kept.
*.pbs
# The fixed-trace campaign scripts are portable templates: every site-specific
# path is supplied through environment variables, so keep them with the
# reproducible benchmark harness.
!docs/evidence/bench/soc_fixed_trace/*.pbs
!benchmark/cluster/*.pbs
*.o[0-9]*
*.e[0-9]*

# Local scratch
scratch/
tmp/
*.tmp
core
/core.*
LocalPreferences.toml
.julia/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
.pytest_cache/
.coverage
*.swp
*~

# Locally built native artefacts
*.o
*.a
*.so
*.dylib
*.dll
