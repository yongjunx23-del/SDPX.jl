# Julia environment resolution — a package must not pin its dependents.
Manifest.toml
**/Manifest.toml

# Documentation build output
docs/build/
docs/site/
/.ghcache/

# Coverage and profiling artefacts
*.jl.cov
*.jl.*.cov
*.jl.mem
coverage/
lcov.info
*.prof
*.trace
flamegraph*.svg

# Python bytecode from the rebuild tooling under scripts/rebuild/.
# This matters more than it looks: test/runtests.jl refuses to run while
# `git status --porcelain` is non-empty, so importing one of those tools from
# inside the package dirtied the tree and broke the suite's own precondition.
# The same class of mistake as the bare `core` pattern that once hid src/core/.
__pycache__/
*.pyc

# Generated benchmark inputs and results can be large.
benchmark/CSDR/
benchmark/general/data/**
!benchmark/general/data/.gitignore
!benchmark/general/data/MANIFEST.sha256
benchmark/bootstrap/out/
benchmark/out/
/work/

# Machine-specific scheduler scripts. These embed absolute paths, usernames and
# site-specific module environments; the portable drivers they invoke are the
# reproducible part and are kept.
*.pbs
*.o[0-9]*
*.e[0-9]*

# Local scratch and autoresearch session state
.auto/
scratch/
tmp/
*.tmp

# Crash dumps. The bare `core` pattern matches a directory named `core` at ANY
# depth, so it also captured the real source directory `src/core/`. That hid
# deliverables from `git status` and therefore from the fresh-process clean-tree
# gate, which is defined as an empty `git status --porcelain`
# (benchmark/optimization/v2_fresh_process_profile.jl:162). Re-include the
# source directory; genuine core dumps are still ignored.
core
!/src/core/
/core.*
LocalPreferences.toml
.julia/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
.pytest_cache/
.coverage
*.swp
*~

# Locally built native artefacts
*.o
*.a
*.so
*.dylib
*.dll
